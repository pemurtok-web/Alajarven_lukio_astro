---
import { getUpcomingEvents, urlFor, retinaSrcSet, type EventItem } from '../lib/sanity';
import { Calendar as CalendarIcon, Clock, MapPin, ChevronRight, ChevronLeft, Sparkles, X, Info } from 'lucide-astro';
import PortableText from './PortableText.astro';

const events = await getUpcomingEvents();

function formatDateBadge(dateStr: string) {
  const d = new Date(dateStr);
  const day = d.getDate();
  const monthNames = ['TAM', 'HEL', 'MAA', 'HUB', 'TOU', 'KES', 'HEI', 'ELO', 'SYY', 'LOK', 'MAR', 'JOUL'];
  const month = monthNames[d.getMonth()] || 'SYY';
  const fullDate = `${day}.${d.getMonth() + 1}.${d.getFullYear()}`;
  return { day, month, fullDate };
}

const pad2 = (n: number) => String(n).padStart(2, '0');
const MONTH_NAMES_FI = [
  'Tammikuu', 'Helmikuu', 'Maaliskuu', 'Huhtikuu', 'Toukokuu', 'Kesäkuu',
  'Heinäkuu', 'Elokuu', 'Syyskuu', 'Lokakuu', 'Marraskuu', 'Joulukuu',
];
const WEEKDAY_NAMES_FI = ['Ma', 'Ti', 'Ke', 'To', 'Pe', 'La', 'Su'];

const today = new Date();
const todayKey = `${today.getFullYear()}-${pad2(today.getMonth() + 1)}-${pad2(today.getDate())}`;

const monthParam = Astro.url.searchParams.get('month');
let calYear = today.getFullYear();
let calMonth = today.getMonth();
if (monthParam && /^\d{4}-\d{2}$/.test(monthParam)) {
  const [y, m] = monthParam.split('-').map(Number);
  if (m >= 1 && m <= 12) {
    calYear = y;
    calMonth = m - 1;
  }
}

const monthLabel = `${MONTH_NAMES_FI[calMonth]} ${calYear}`;
const isCurrentMonth = calYear === today.getFullYear() && calMonth === today.getMonth();

const prevMonthDate = new Date(calYear, calMonth - 1, 1);
const nextMonthDate = new Date(calYear, calMonth + 1, 1);
const prevHref = `?month=${prevMonthDate.getFullYear()}-${pad2(prevMonthDate.getMonth() + 1)}#tapahtumakalenteri`;
const nextHref = `?month=${nextMonthDate.getFullYear()}-${pad2(nextMonthDate.getMonth() + 1)}#tapahtumakalenteri`;
const todayHref = `${Astro.url.pathname}#tapahtumakalenteri`;

const eventsByDate = new Map<string, EventItem[]>();
for (const evt of events) {
  const key = evt.date?.slice(0, 10);
  if (!key) continue;
  const list = eventsByDate.get(key) ?? [];
  list.push(evt);
  eventsByDate.set(key, list);
}

const firstWeekday = (new Date(calYear, calMonth, 1).getDay() + 6) % 7; // Monday = 0
const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
const totalCells = Math.ceil((firstWeekday + daysInMonth) / 7) * 7;

const calendarCells = Array.from({ length: totalCells }, (_, i) => {
  const d = new Date(calYear, calMonth, i - firstWeekday + 1);
  const key = `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
  return {
    key,
    day: d.getDate(),
    inMonth: d.getMonth() === calMonth,
    isToday: key === todayKey,
    events: eventsByDate.get(key) ?? [],
  };
});

const visibleEvents = calendarCells.flatMap((c) => c.events);
---

<section id="tapahtumakalenteri" class="py-20 bg-transparent border-t border-slate-200/40 scroll-mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Section Info Left (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider">
          <CalendarIcon class="w-3.5 h-3.5 text-emerald-600" />
          <span>Tapahtumakalenteri</span>
        </div>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-alajarvi-900 tracking-tight">
          Tulevat tapahtumat & lukuvuoden tärkeät päivämäärät
        </h2>
        <p class="text-slate-600 text-base leading-relaxed">
          Pysy ajan tasalla lukion tapahtumista, kokeista, vanhempainilloista ja loma-ajoista. Klikkaa tapahtumaa lukeaksesi lisätiedot!
        </p>

        <div class="pt-4 p-5 rounded-2xl bg-alajarvi-50 border border-alajarvi-100 space-y-2">
          <div class="flex items-center gap-2 text-alajarvi-800 font-bold text-sm">
            <Sparkles class="w-4 h-4 text-alajarvi-500" />
            <span>Onko sinulla kysyttävää aikatauluista?</span>
          </div>
          <p class="text-xs text-slate-600">
            Tarkemmat ryhmäkohtaiset lukujärjestykset ja kokeiden salijaot löydät aina Wilmasta.
          </p>
          <a
            href="https://alajarvi.inschool.fi"
            target="_blank"
            class="inline-block pt-1 text-xs font-bold text-alajarvi-600 hover:text-alajarvi-800 underline"
          >
            Siirry Wilmaan →
          </a>
        </div>
      </div>

      <!-- Month Calendar Right (8 cols) -->
      <div class="lg:col-span-8 space-y-4">

        <!-- Calendar Header / Navigation -->
        <div class="flex items-center justify-between gap-3 px-1">
          <h3 class="font-display font-bold text-xl sm:text-2xl text-alajarvi-900 tracking-tight">
            {monthLabel}
          </h3>
          <div class="flex items-center gap-2">
            {!isCurrentMonth && (
              <a
                href={todayHref}
                class="hidden sm:inline-flex items-center px-3 py-2 rounded-xl bg-alajarvi-50 hover:bg-alajarvi-100 text-alajarvi-700 text-xs font-bold transition-colors"
              >
                Tänään
              </a>
            )}
            <a
              href={prevHref}
              aria-label="Edellinen kuukausi"
              class="w-9 h-9 rounded-xl bg-white hover:bg-slate-100 border border-slate-200/80 text-slate-600 flex items-center justify-center transition-colors shadow-xs"
            >
              <ChevronLeft class="w-4 h-4" />
            </a>
            <a
              href={nextHref}
              aria-label="Seuraava kuukausi"
              class="w-9 h-9 rounded-xl bg-white hover:bg-slate-100 border border-slate-200/80 text-slate-600 flex items-center justify-center transition-colors shadow-xs"
            >
              <ChevronRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Calendar Grid -->
        <div class="overflow-x-auto">
          <div class="min-w-[320px] rounded-2xl border border-slate-200/80 bg-white shadow-xs overflow-hidden">
            <!-- Weekday Header -->
            <div class="grid grid-cols-7 bg-slate-50 border-b border-slate-200/80">
              {WEEKDAY_NAMES_FI.map((wd) => (
                <div class="py-1.5 sm:py-2.5 text-center text-[10px] sm:text-xs font-bold uppercase tracking-wider text-slate-500">
                  {wd}
                </div>
              ))}
            </div>
            <!-- Day Cells -->
            <div class="grid grid-cols-7">
              {calendarCells.map((cell) => (
                <div
                  class:list={[
                    'min-h-[58px] sm:min-h-[92px] p-1 sm:p-2 border-b border-r border-slate-100 last:border-r-0 flex flex-col gap-0.5 sm:gap-1',
                    !cell.inMonth && 'bg-slate-50/60',
                    cell.isToday && 'bg-alajarvi-50 ring-1 ring-inset ring-alajarvi-300',
                  ]}
                >
                  <span
                    class:list={[
                      'relative text-[10px] sm:text-xs font-bold w-5 h-5 sm:w-6 sm:h-6 flex items-center justify-center rounded-full shrink-0',
                      cell.inMonth ? 'text-slate-700' : 'text-slate-300',
                      cell.isToday && 'bg-alajarvi-600 text-white',
                    ]}
                  >
                    {cell.isToday && (
                      <span class="animate-pulse-ring absolute inset-0 rounded-full bg-alajarvi-400 pointer-events-none" aria-hidden="true"></span>
                    )}
                    <span class="relative z-10">{cell.day}</span>
                  </span>
                  <div class="flex flex-col gap-0.5 sm:gap-1">
                    {cell.events.slice(0, 3).map((evt) => (
                      <button
                        type="button"
                        data-modal-target={`event-modal-${evt._id}`}
                        class:list={[
                          'event-modal-trigger w-full text-left px-1 py-0.5 sm:px-1.5 sm:py-1 rounded sm:rounded-md text-[9px] sm:text-[11px] leading-tight font-semibold truncate transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-alajarvi-500',
                          cell.inMonth
                            ? 'bg-alajarvi-100 text-alajarvi-800 hover:bg-alajarvi-200'
                            : 'bg-slate-100 text-slate-400 hover:bg-slate-200',
                        ]}
                        title={evt.title}
                      >
                        {evt.title}
                      </button>
                    ))}
                    {cell.events.length > 3 && (
                      <span class="text-[9px] sm:text-[10px] font-semibold text-slate-400 px-1 sm:px-1.5">
                        +{cell.events.length - 3} lisää
                      </span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {visibleEvents.length === 0 && (
          <p class="text-sm text-slate-500 px-1">Ei tapahtumia tässä kuussa.</p>
        )}

        {visibleEvents.map((evt) => {
          const modalId = `event-modal-${evt._id}`;
          return (
              <!-- Event Details Modal -->
              <div
                id={modalId}
                class="event-modal-overlay fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-md hidden items-center justify-center p-4 sm:p-6 overflow-y-auto"
                aria-modal="true"
                role="dialog"
              >
                <div class="relative w-full max-w-2xl bg-white rounded-3xl shadow-2xl overflow-hidden border border-slate-100 max-h-[90vh] flex flex-col my-auto animate-in fade-in zoom-in-95 duration-200">
                  
                  <!-- Modal Header / Image -->
                  {evt.image ? (
                    <div class="relative w-full h-56 sm:h-72 shrink-0 bg-slate-900">
                      <img
                        src={urlFor(evt.image)?.width(1200).height(600).fit('crop').url()}
                        srcset={retinaSrcSet(evt.image, 1200, 600)}
                        width={1200}
                        height={600}
                        alt={evt.title}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>
                      <button
                        type="button"
                        data-modal-close={modalId}
                        class="absolute top-4 right-4 w-10 h-10 rounded-full bg-slate-900/80 text-white hover:bg-slate-900 flex items-center justify-center backdrop-blur-md transition-all shadow-lg hover:scale-105 cursor-pointer"
                        aria-label="Sulje"
                      >
                        <X class="w-5 h-5" />
                      </button>
                      <div class="absolute bottom-4 left-6 right-6 text-white space-y-1">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-bold uppercase tracking-wider text-white">
                          <CalendarIcon class="w-3.5 h-3.5" />
                          <span>{formatDateBadge(evt.date).fullDate}</span>
                        </div>
                        <h3 class="font-display font-extrabold text-2xl sm:text-3xl text-white tracking-tight drop-shadow-md">
                          {evt.title}
                        </h3>
                      </div>
                    </div>
                  ) : (
                    <div class="relative p-6 sm:p-8 bg-gradient-to-br from-alajarvi-600 to-alajarvi-800 text-white shrink-0">
                      <button
                        type="button"
                        data-modal-close={modalId}
                        class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-md cursor-pointer"
                        aria-label="Sulje"
                      >
                        <X class="w-5 h-5" />
                      </button>
                      <div class="space-y-2 pr-8">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-bold uppercase tracking-wider text-white">
                          <CalendarIcon class="w-3.5 h-3.5" />
                          <span>{formatDateBadge(evt.date).fullDate}</span>
                        </div>
                        <h3 class="font-display font-extrabold text-2xl sm:text-3xl text-white tracking-tight">
                          {evt.title}
                        </h3>
                      </div>
                    </div>
                  )}

                  <!-- Modal Body -->
                  <div class="p-6 sm:p-8 overflow-y-auto space-y-6 flex-1">
                    
                    <!-- Time & Location Badges -->
                    <div class="flex flex-wrap items-center gap-3 text-sm font-semibold text-slate-700 bg-slate-50 p-4 rounded-2xl border border-slate-200/80">
                      {evt.time && (
                        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white border border-slate-200 shadow-2xs">
                          <Clock class="w-4 h-4 text-alajarvi-600" />
                          <span>{evt.time}</span>
                        </div>
                      )}
                      {evt.location && (
                        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white border border-slate-200 shadow-2xs">
                          <MapPin class="w-4 h-4 text-alajarvi-600" />
                          <span>{evt.location}</span>
                        </div>
                      )}
                    </div>

                    <!-- Short Description Callout -->
                    {evt.description && (
                      <div class="p-4 rounded-2xl bg-alajarvi-50 border border-alajarvi-100 text-alajarvi-950 font-medium text-base leading-relaxed">
                        {evt.description}
                      </div>
                    )}

                    <!-- Extended Body (PortableText) -->
                    {evt.body && (
                      <div class="space-y-3 pt-2">
                        <h4 class="font-display font-bold text-lg text-slate-900 flex items-center gap-2">
                          <Info class="w-5 h-5 text-alajarvi-600" />
                          <span>Tapahtuman lisätiedot & ohjelma</span>
                        </h4>
                        <div class="prose prose-slate max-w-none">
                          <PortableText value={evt.body} />
                        </div>
                      </div>
                    )}

                  </div>

                  <!-- Modal Footer -->
                  <div class="p-4 sm:px-8 bg-slate-50 border-t border-slate-200/80 flex items-center justify-between gap-4 shrink-0">
                    <span class="text-xs text-slate-500 flex items-center gap-1">
                      <Sparkles class="w-3.5 h-3.5 text-alajarvi-500" />
                      <span>Alajärven lukion tapahtumakalenteri</span>
                    </span>
                    <button
                      type="button"
                      data-modal-close={modalId}
                      class="px-5 py-2.5 rounded-xl bg-alajarvi-600 hover:bg-alajarvi-700 text-white text-xs font-bold transition-all shadow-sm active:scale-95 cursor-pointer"
                    >
                      Sulje ikkuna
                    </button>
                  </div>

                </div>
              </div>
          );
        })}
      </div>

    </div>
  </div>
</section>

<!-- Client Script for Modal Dialogs -->
<script>
  function setupModals() {
    const triggers = document.querySelectorAll<HTMLButtonElement>('.event-modal-trigger');
    const closeButtons = document.querySelectorAll<HTMLButtonElement>('[data-modal-close]');
    const overlays = document.querySelectorAll<HTMLDivElement>('.event-modal-overlay');

    function openModal(modalId: string) {
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal(modalId: string) {
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      }
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const modalId = trigger.getAttribute('data-modal-target');
        if (modalId) openModal(modalId);
      });
    });

    closeButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const modalId = btn.getAttribute('data-modal-close');
        if (modalId) closeModal(modalId);
      });
    });

    overlays.forEach((overlay) => {
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) {
          const modalId = overlay.id;
          if (modalId) closeModal(modalId);
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        overlays.forEach((overlay) => {
          if (!overlay.classList.contains('hidden')) {
            closeModal(overlay.id);
          }
        });
      }
    });
  }

  setupModals();
  document.addEventListener('astro:page-load', setupModals);
</script>
