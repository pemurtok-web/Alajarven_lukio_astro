---
import { getQuickLinks, getSiteSettings, getAllPages, urlForLogo, getImageDimensions } from '../lib/sanity';
import { ExternalLink, ChevronDown, Menu, X, BookOpen, Utensils, GraduationCap, Home, Globe, Megaphone, Phone, FileText } from 'lucide-astro';

const quickLinks = await getQuickLinks();
const siteSettings = await getSiteSettings();
const allPages = await getAllPages();

const logoUrl = siteSettings.logoImage ? urlForLogo(siteSettings.logoImage)?.url() : null;
const logoDims = siteSettings.logoImage ? getImageDimensions(siteSettings.logoImage) : undefined;

const opiskelijallePages = [
  { title: 'Opinto-opas', href: '/opiskelijalle/opinto-opas' },
  { title: 'Opintotarjotin', href: '/opiskelijalle/opintotarjotin' },
  { title: 'Työaika', href: '/opiskelijalle/tyoaika' },
  { title: 'Opinto-ohjaus', href: '/opiskelijalle/opinto-ohjaus' },
  { title: 'Opiskeluhuolto', href: '/opiskelijalle/opiskeluhuolto' },
  { title: 'YO-kirjoitukset', href: '/opiskelijalle/yo-kirjoitukset' },
  { title: 'Lomakkeet', href: '/opiskelijalle/lomakkeet' },
  { title: 'Kodin ja koulun yhteistyö', href: '/opiskelijalle/kodin-ja-koulun-yhteistyo' },
  { title: 'Opetussuunnitelma', href: '/opiskelijalle/opetussuunnitelma' },
  { title: 'Ruokalista', href: '/opiskelijalle/ruokalista' },
];

const kansainvalisyysPages = [
  { title: 'Jiyu Gakuen (Japani)', href: '/kansainvalisyys/jiyu-gakuen' },
  { title: 'Mukawa (Japani)', href: '/kansainvalisyys/mukawa' },
  { title: 'Muu kansainvälinen toiminta', href: '/kansainvalisyys/muu' },
];

// Sivut, jotka Sanityssä on merkitty näkymään päävalikossa ("Näytä päävalikossa" -kenttä
// page-schemassa). Näin uusi sisältösivu voidaan tuoda valikkoon ilman koodimuutosta —
// yhdistetään yllä oleviin oletuslistoihin, eikä korvata niitä.
function toMenuLink(section: 'opiskelijalle' | 'kansainvalisyys', page: any) {
  return { title: page.title, href: `/${section}/${page.slug?.current}`, order: page.menuOrder };
}

const sanityOpiskelijaLinks = allPages
  .filter(p => p.menuPlacement === 'opiskelijalle' && p.slug?.current)
  .map(p => toMenuLink('opiskelijalle', p));
const sanityKansainvalisyysLinks = allPages
  .filter(p => p.menuPlacement === 'kansainvalisyys' && p.slug?.current)
  .map(p => toMenuLink('kansainvalisyys', p));

function mergeMenuLinks(defaults: { title: string; href: string }[], extra: { title: string; href: string; order?: number }[]) {
  const existingHrefs = new Set(defaults.map(l => l.href));
  const newOnes = extra
    .filter(l => !existingHrefs.has(l.href))
    .sort((a, b) => (a.order ?? Infinity) - (b.order ?? Infinity));
  return [...defaults, ...newOnes];
}

const opiskelijallePagesAll = mergeMenuLinks(opiskelijallePages, sanityOpiskelijaLinks);
const kansainvalisyysPagesAll = mergeMenuLinks(kansainvalisyysPages, sanityKansainvalisyysLinks);

// Sivut, jotka Sanityssä on merkitty "Erillisenä kohtana päävalikossa" — nämä saavat oman,
// itsenäisen linkin päävalikkoon (ei alavalikkoon), osoitteessa /<slug> (ks. src/pages/[slug].astro).
const topLevelPages = allPages
  .filter(p => p.menuPlacement === 'top' && p.slug?.current)
  .map(p => ({ title: p.title, href: `/${p.slug?.current}`, order: p.menuOrder }))
  .sort((a, b) => (a.order ?? Infinity) - (b.order ?? Infinity));
---

<header class="sticky top-0 z-50 shadow-sm bg-white/95 backdrop-blur-md border-b border-slate-100 transition-all duration-300 w-full max-w-full">
  <!-- Top Quicklinks Bar -->
  <div class="bg-alajarvi-800 text-white text-xs py-2 px-4 sm:px-8 w-full">
    <div class="max-w-7xl mx-auto flex justify-between items-center gap-2">
      <div class="flex items-center space-x-3 text-slate-300 shrink-0">
        <span class="font-medium text-white flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          {siteSettings.title || 'Alajärven lukio'}
        </span>
        <span class="hidden md:inline text-slate-500">|</span>
        <span class="hidden md:inline text-slate-300">{siteSettings.address || 'Koulutie 1, 62900 Alajärvi'}</span>
        {siteSettings.phone && (
          <>
            <span class="hidden lg:inline text-slate-500">|</span>
            <a href={`tel:${siteSettings.phone.replace(/\s+/g, '')}`} class="hidden lg:inline text-slate-300 hover:text-white transition-colors">
              📞 {siteSettings.phone}
            </a>
          </>
        )}
        {siteSettings.email && (
          <>
            <span class="hidden xl:inline text-slate-500">|</span>
            <a href={`mailto:${siteSettings.email}`} class="hidden xl:inline text-slate-300 hover:text-white transition-colors">
              ✉️ {siteSettings.email}
            </a>
          </>
        )}
      </div>

      <!-- Quicklinks Badges -->
      <div class="flex items-center space-x-2 sm:space-x-3 overflow-x-auto shrink max-w-[55%] sm:max-w-none">
        {quickLinks.map(link => (
          <a
            href={link.url}
            target={link.url?.startsWith('/') ? '_self' : '_blank'}
            rel={link.url?.startsWith('/') ? undefined : 'noopener noreferrer'}
            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-white/10 hover:bg-alajarvi-500 text-slate-100 hover:text-white transition-all text-xs font-medium border border-white/10 shrink-0"
          >
            {link.icon === 'wilma' && <GraduationCap class="w-3.5 h-3.5 text-blue-300" />}
            {link.icon === 'utensils' && <Utensils class="w-3.5 h-3.5 text-amber-300" />}
            {link.icon === 'book-open' && <BookOpen class="w-3.5 h-3.5 text-emerald-300" />}
            <span>{link.title}</span>
            <ExternalLink class="w-3 h-3 opacity-70 ml-0.5" />
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-3.5 flex items-center justify-between gap-4">
    <!-- Brand Logo & Text -->
    <a href="/" class="group flex items-center gap-3 shrink-0">
      {logoUrl ? (
        <img
          src={logoUrl}
          width={logoDims?.width}
          height={logoDims?.height}
          alt={siteSettings.title || 'Alajärven lukio logo'}
          loading="eager"
          fetchpriority="high"
          class="h-9 sm:h-11 w-auto max-w-[140px] sm:max-w-[180px] max-h-11 object-contain group-hover:scale-105 transition-transform shrink-0"
        />
      ) : (
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-alajarvi-500 to-alajarvi-700 flex items-center justify-center text-white font-bold text-xl shadow-md group-hover:scale-105 transition-transform">
          AL
        </div>
      )}
      <div>
        <span class="block font-display font-extrabold text-base sm:text-xl text-alajarvi-800 tracking-tight leading-none group-hover:text-alajarvi-500 transition-colors">
          {siteSettings.title || 'ALAJÄRVEN LUKIO'}
        </span>
        <span class="block text-[10px] sm:text-[11px] font-semibold text-slate-500 uppercase tracking-widest mt-1">
          {siteSettings.subtitle || 'SIVISTYS & OSAAMINEN'}
        </span>
      </div>
    </a>


    <!-- Desktop Navigation Menu -->
    <nav class="hidden lg:flex items-center space-x-1">
      <a href="/" class="px-3.5 py-2 rounded-lg text-sm xl:text-base font-medium text-slate-700 hover:text-alajarvi-500 hover:bg-alajarvi-50 transition-colors">
        Etusivu
      </a>

      <!-- Opiskelijalle Dropdown -->
      <div class="relative group">
        <button class="px-3.5 py-2 rounded-lg text-sm xl:text-base font-medium text-slate-700 hover:text-alajarvi-500 hover:bg-alajarvi-50 transition-colors inline-flex items-center gap-1">
          <span>Opiskelijalle</span>
          <ChevronDown class="w-4 h-4 text-slate-400 group-hover:rotate-180 transition-transform duration-200" />
        </button>
        <div class="absolute left-0 mt-1 w-64 rounded-xl bg-white shadow-xl border border-slate-100 p-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 transform origin-top-left group-hover:translate-y-0 translate-y-2">
          {opiskelijallePagesAll.map(page => (
            <a
              href={page.href}
              class="block px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-alajarvi-50 hover:text-alajarvi-600 transition-colors font-medium"
            >
              {page.title}
            </a>
          ))}
        </div>
      </div>

      <!-- Hakijalle (Long Page) -->
      <a href="/hakijalle" class="px-3.5 py-2 rounded-lg text-sm xl:text-base font-medium text-slate-700 hover:text-alajarvi-500 hover:bg-alajarvi-50 transition-colors">
        Hakijalle
      </a>

      <!-- Kansainvälisyys Dropdown -->
      <div class="relative group">
        <a href="/kansainvalisyys" class="px-3.5 py-2 rounded-lg text-sm xl:text-base font-medium text-slate-700 hover:text-alajarvi-500 hover:bg-alajarvi-50 transition-colors inline-flex items-center gap-1">
          <span>Kansainvälisyys</span>
          <ChevronDown class="w-4 h-4 text-slate-400 group-hover:rotate-180 transition-transform duration-200" />
        </a>
        <div class="absolute left-0 mt-1 w-64 rounded-xl bg-white shadow-xl border border-slate-100 p-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 transform origin-top-left group-hover:translate-y-0 translate-y-2">
          {kansainvalisyysPagesAll.map(page => (
            <a
              href={page.href}
              class="block px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-alajarvi-50 hover:text-alajarvi-600 transition-colors font-medium"
            >
              {page.title}
            </a>
          ))}
        </div>
      </div>

      <!-- Ajankohtaista Archive -->
      <a href="/ajankohtaista" class="px-3.5 py-2 rounded-lg text-sm xl:text-base font-medium text-slate-700 hover:text-alajarvi-500 hover:bg-alajarvi-50 transition-colors">
        Ajankohtaista
      </a>

      <!-- Sanityssä "Erillisenä kohtana päävalikossa" -sivut -->
      {topLevelPages.map(page => (
        <a href={page.href} class="px-3.5 py-2 rounded-lg text-sm xl:text-base font-medium text-slate-700 hover:text-alajarvi-500 hover:bg-alajarvi-50 transition-colors">
          {page.title}
        </a>
      ))}

      <!-- Yhteystiedot (Long Page) -->
      <a href="/yhteystiedot" class="ml-2 px-4 py-2 rounded-lg text-sm xl:text-base font-semibold text-white bg-alajarvi-500 hover:bg-alajarvi-600 shadow-sm hover:shadow transition-all">
        Yhteystiedot
      </a>
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden p-2.5 rounded-xl text-slate-700 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-alajarvi-500 min-w-[44px] min-h-[44px] flex items-center justify-center border border-slate-200/60 active:scale-95 transition-all"
      aria-label="Avaa päävalikko"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Menu id="icon-open" class="w-6 h-6" />
      <X id="icon-close" class="w-6 h-6 hidden" />
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-100 bg-white/98 backdrop-blur-lg shadow-2xl max-h-[85vh] flex flex-col">
    <div class="flex flex-col px-4 pt-3 pb-2 overflow-y-auto divide-y divide-slate-100">
      <a href="/" class="flex items-center gap-3 px-3 py-3 text-base font-semibold text-slate-800 hover:bg-alajarvi-50 hover:text-alajarvi-600 rounded-xl transition-colors">
        <Home class="w-[18px] h-[18px] text-alajarvi-400 shrink-0" />
        Etusivu
      </a>

      <details class="group">
        <summary class="flex items-center gap-3 px-3 py-3 text-base font-semibold text-slate-800 hover:bg-alajarvi-50 hover:text-alajarvi-600 rounded-xl transition-colors cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <GraduationCap class="w-[18px] h-[18px] text-alajarvi-400 shrink-0" />
          <span class="flex-1">Opiskelijalle</span>
          <ChevronDown class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0" />
        </summary>
        <div class="pb-1 pl-4 grid grid-cols-2 gap-1">
          {opiskelijallePagesAll.map(page => (
            <a href={page.href} class="block px-3 py-2 text-sm font-medium text-slate-600 hover:text-alajarvi-600 hover:bg-alajarvi-50 rounded-lg transition-colors">
              {page.title}
            </a>
          ))}
        </div>
      </details>

      <a href="/hakijalle" class="flex items-center gap-3 px-3 py-3 text-base font-semibold text-slate-800 hover:bg-alajarvi-50 hover:text-alajarvi-600 rounded-xl transition-colors">
        <BookOpen class="w-[18px] h-[18px] text-alajarvi-400 shrink-0" />
        Hakijalle
      </a>

      <details class="group">
        <summary class="flex items-center gap-3 px-3 py-3 text-base font-semibold text-slate-800 hover:bg-alajarvi-50 hover:text-alajarvi-600 rounded-xl transition-colors cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <Globe class="w-[18px] h-[18px] text-alajarvi-400 shrink-0" />
          <span class="flex-1">Kansainvälisyys</span>
          <ChevronDown class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0" />
        </summary>
        <div class="pb-1 pl-4 space-y-1">
          <a href="/kansainvalisyys" class="block px-3 py-2 text-sm font-bold text-alajarvi-600 hover:bg-alajarvi-50 rounded-lg transition-colors">
            Yleiskatsaus
          </a>
          {kansainvalisyysPagesAll.map(page => (
            <a href={page.href} class="block px-3 py-2 text-sm font-medium text-slate-600 hover:text-alajarvi-600 hover:bg-alajarvi-50 rounded-lg transition-colors">
              {page.title}
            </a>
          ))}
        </div>
      </details>

      <a href="/ajankohtaista" class="flex items-center gap-3 px-3 py-3 text-base font-semibold text-slate-800 hover:bg-alajarvi-50 hover:text-alajarvi-600 rounded-xl transition-colors">
        <Megaphone class="w-[18px] h-[18px] text-alajarvi-400 shrink-0" />
        Ajankohtaista
      </a>

      <!-- Sanityssä "Erillisenä kohtana päävalikossa" -sivut -->
      {topLevelPages.map(page => (
        <a href={page.href} class="flex items-center gap-3 px-3 py-3 text-base font-semibold text-slate-800 hover:bg-alajarvi-50 hover:text-alajarvi-600 rounded-xl transition-colors">
          <FileText class="w-[18px] h-[18px] text-alajarvi-400 shrink-0" />
          {page.title}
        </a>
      ))}
    </div>

    <!-- Sticky CTA — always visible without scrolling the list above -->
    <div class="shrink-0 px-4 py-3 border-t border-slate-100 bg-white/98 backdrop-blur-lg" style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom))">
      <a href="/yhteystiedot" class="flex items-center justify-center gap-2 w-full px-4 py-3 rounded-xl text-base font-bold text-white bg-alajarvi-500 hover:bg-alajarvi-600 shadow-md active:scale-95 transition-all">
        <Phone class="w-[18px] h-[18px]" />
        Yhteystiedot
      </a>
    </div>
  </div>
</header>

<script>
  const headerEl = document.querySelector('header');
  if (headerEl) {
    const setHeaderHeightVar = () => {
      document.documentElement.style.setProperty('--header-h', `${headerEl.getBoundingClientRect().height}px`);
    };
    setHeaderHeightVar();
    new ResizeObserver(setHeaderHeightVar).observe(headerEl);
  }

  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  if (menuBtn && menu && iconOpen && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      if (isOpen) {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.setAttribute('aria-label', 'Avaa päävalikko');
      } else {
        menu.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
        menuBtn.setAttribute('aria-expanded', 'true');
        menuBtn.setAttribute('aria-label', 'Sulje päävalikko');
      }
    });

    // Close menu when clicking links inside
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  }
</script>
