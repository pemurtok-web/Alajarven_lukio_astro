---
interface AnchorItem {
  id: string;
  label: string;
}

interface Props {
  anchors: AnchorItem[];
  title?: string;
}

const { anchors, title = 'Sivun osiot' } = Astro.props;
---

<nav class="sticky top-16 sm:top-20 z-40 bg-white/95 backdrop-blur-md rounded-2xl shadow-md border border-slate-200/80 p-3 sm:p-4 mb-8">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-2.5">
    <span class="text-xs font-bold uppercase tracking-wider text-alajarvi-700 flex items-center gap-2 shrink-0">
      <span class="w-2 h-2 rounded-full bg-alajarvi-500 animate-pulse"></span>
      {title}
    </span>
    <div class="flex overflow-x-auto gap-2 pb-1 pt-0.5 sm:pb-0 scrollbar-none snap-x max-w-full -mx-1 px-1">
      {anchors.map(item => (
        <a
          href={`#${item.id}`}
          class="whitespace-nowrap shrink-0 snap-start px-3.5 py-2 sm:py-1.5 rounded-full text-xs font-semibold text-slate-700 hover:text-alajarvi-600 bg-slate-100 hover:bg-alajarvi-50 border border-slate-200/70 hover:border-alajarvi-300 transition-all shadow-xs active:scale-95"
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</nav>
