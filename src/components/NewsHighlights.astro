---
import { getTopNews, urlFor, retinaSrcSet } from '../lib/sanity';
import { Calendar, ArrowRight, Newspaper } from 'lucide-astro';

const newsItems = await getTopNews(3);
---

<section class="py-16 sm:py-20 bg-transparent border-t border-slate-200/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-alajarvi-100 text-alajarvi-700 text-xs font-bold uppercase tracking-wider mb-3">
          <Newspaper class="w-3.5 h-3.5" />
          <span>Ajankohtaista</span>
        </div>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-alajarvi-900 tracking-tight">
          Viimeisimmät uutiset ja tiedotteet
        </h2>
        <p class="text-slate-600 mt-2 text-base max-w-2xl">
          Seuraa Alajärven lukion tapahtumia, opiskelijoiden menestystä ja lukuvuoden tärkeitä tiedotteita.
        </p>
      </div>

      <a
        href="/ajankohtaista"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm text-alajarvi-700 bg-white hover:bg-alajarvi-50 border border-slate-200 shadow-xs hover:border-alajarvi-200 transition-all shrink-0"
      >
        <span>Katso kaikki uutiset</span>
        <ArrowRight class="w-4 h-4" />
      </a>
    </div>

    <!-- 3 News Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {newsItems.map((item) => (
        <article class="group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl border border-slate-200/80 hover:border-alajarvi-200 transition-all duration-300 flex flex-col h-full transform hover:-translate-y-1">
          <!-- Thumbnail Image / Visual Badge -->
          <div class="relative h-48 bg-gradient-to-br from-alajarvi-600 to-alajarvi-800 overflow-hidden">
            {item.mainImage ? (
              <img
                src={urlFor(item.mainImage)?.width(600).height(400).fit('crop').url() || ''}
                srcset={retinaSrcSet(item.mainImage, 600, 400)}
                width={600}
                height={400}
                alt={item.title}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center p-6 text-center bg-gradient-to-br from-alajarvi-700 to-alajarvi-900">
                <Newspaper class="w-12 h-12 text-alajarvi-300/40" />
              </div>
            )}
            
            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold text-alajarvi-800 flex items-center gap-1.5 shadow-sm">
              <Calendar class="w-3.5 h-3.5 text-alajarvi-500" />
              <span>{new Date(item.publishedAt).toLocaleDateString('fi-FI')}</span>
            </div>
          </div>

          <!-- Content Body -->
          <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <h3 class="font-display font-bold text-xl text-slate-900 group-hover:text-alajarvi-600 transition-colors leading-snug line-clamp-2">
                <a href={`/ajankohtaista/${item.slug.current}`}>
                  {item.title}
                </a>
              </h3>
              <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed">
                {item.excerpt}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <a
                href={`/ajankohtaista/${item.slug.current}`}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-alajarvi-600 hover:text-alajarvi-800 transition-colors"
              >
                <span>Lue koko uutinen</span>
                <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
