---
import { responsiveImage } from '../lib/sanity';
import { FileText, Download } from 'lucide-astro';
import YouTubeEmbed from './YouTubeEmbed.astro';

interface Props {
  value: any;
}

const { value } = Astro.props;

// Helper to render portable text spans with link marks, bold, italic
function renderChildren(block: any) {
  if (!block || !block.children) return '';
  
  const markDefsMap: Record<string, any> = {};
  if (block.markDefs && Array.isArray(block.markDefs)) {
    block.markDefs.forEach((def: any) => {
      if (def._key) markDefsMap[def._key] = def;
    });
  }

  return block.children.map((child: any) => {
    let text = child.text || '';
    if (!text) return '';

    // Process marks (links, bold, italic, underline, strikethrough, indent)
    if (child.marks && Array.isArray(child.marks) && child.marks.length > 0) {
      child.marks.forEach((markKey: string) => {
        const def = markDefsMap[markKey];
        if (def && (def._type === 'link' || def._type === 'url') && def.href) {
          const isExternal = def.href.startsWith('http');
          const targetAttr = isExternal ? 'target="_blank" rel="noopener noreferrer"' : '';
          if (def.style === 'button') {
            const arrow = isExternal ? '↗' : '→';
            const isLarge = def.size === 'large';
            const sizeClasses = isLarge ? 'gap-2 px-7 py-4 text-lg' : 'gap-1.5 px-4 py-2 text-sm';
            text = `<a href="${def.href}" ${targetAttr} class="group inline-flex items-center ${sizeClasses} my-1 rounded-xl bg-alajarvi-500 hover:bg-alajarvi-600 text-white font-bold no-underline shadow-sm hover:shadow-md active:scale-95 transition-all shrink-0">${text}<span class="transition-transform group-hover:translate-x-0.5">${arrow}</span></a>`;
          } else {
            text = `<a href="${def.href}" ${targetAttr} class="font-bold text-alajarvi-600 hover:text-alajarvi-800 underline decoration-alajarvi-300 hover:decoration-alajarvi-600 transition-colors inline-flex items-center gap-1 shrink-0">${text} ${isExternal ? '↗' : ''}</a>`;
          }
        } else if (markKey === 'strong' || markKey === 'bold') {
          text = `<strong class="font-bold text-slate-900">${text}</strong>`;
        } else if (markKey === 'em' || markKey === 'italic') {
          text = `<em class="italic text-slate-800">${text}</em>`;
        } else if (markKey === 'underline') {
          text = `<u class="underline decoration-slate-400">${text}</u>`;
        } else if (markKey === 'strike-through' || markKey === 'strikethrough') {
          text = `<del class="line-through text-slate-400">${text}</del>`;
        } else if (markKey === 'indent') {
          text = `<span class="inline-block pl-4 sm:pl-6 border-l-2 border-alajarvi-400 my-0.5 ml-1 mr-1 text-slate-800 font-medium">${text}</span>`;
        }
      });
    }
    return text;
  }).join('');
}
---

{value && Array.isArray(value) ? (
  <div class="prose prose-slate max-w-3xl prose-headings:font-display prose-headings:text-alajarvi-800 prose-a:text-alajarvi-600 hover:prose-a:text-alajarvi-800 prose-img:rounded-2xl overflow-x-auto break-words space-y-4">
    {value.map((block: any, idx: number) => {
      if (block._type === 'block') {
        const htmlContent = renderChildren(block);
        if (!htmlContent) return null;

        if (block.listItem) {
          const indentClass = block.level > 2 ? 'ml-12' : block.level === 2 ? 'ml-6' : '';
          if (block.listItem === 'bullet') {
            return <li key={idx} class={`list-disc list-inside text-slate-700 mb-1 ${indentClass}`} set:html={htmlContent} />;
          }
          if (block.listItem === 'number') {
            return <li key={idx} class={`list-decimal list-inside text-slate-700 mb-1 ${indentClass}`} set:html={htmlContent} />;
          }
        }

        if (block.style === 'h2') {
          const headingId = `heading-${idx}`;
          return <h2 id={headingId} key={idx} class="clear-both pt-6 text-2xl font-bold text-alajarvi-800 mt-8 mb-4 scroll-mt-28" style="scroll-margin-top: var(--anchor-offset, 112px)" set:html={htmlContent} />;
        }
        if (block.style === 'h3') {
          const headingId = `heading-${idx}`;
          return <h3 id={headingId} key={idx} class="clear-both pt-6 text-xl font-bold text-alajarvi-700 mt-6 mb-3 scroll-mt-28" style="scroll-margin-top: var(--anchor-offset, 112px)" set:html={htmlContent} />;
        }
        if (block.style === 'blockquote') {
          return <blockquote key={idx} class="border-l-4 border-alajarvi-500 pl-4 italic text-slate-600 my-4" set:html={htmlContent} />;
        }
        if (block.style === 'indent-1' || block.style === 'indent') {
          return <div key={idx} class="pl-6 sm:pl-8 border-l-2 border-alajarvi-400 my-3 text-slate-700 leading-relaxed font-medium bg-alajarvi-50/40 p-3 rounded-r-xl" set:html={htmlContent} />;
        }
        if (block.style === 'indent-2') {
          return <div key={idx} class="pl-10 sm:pl-12 border-l-4 border-alajarvi-500 my-3 text-slate-700 leading-relaxed font-medium bg-alajarvi-50/70 p-3 rounded-r-xl" set:html={htmlContent} />;
        }
        if (block.style === 'indent-3') {
          return <div key={idx} class="pl-14 sm:pl-16 border-l-4 border-alajarvi-600 my-3 text-slate-700 leading-relaxed font-medium bg-alajarvi-100/70 p-3.5 rounded-r-xl" set:html={htmlContent} />;
        }
        return <p key={idx} class="text-slate-700 leading-relaxed mb-4" set:html={htmlContent} />;
      }
      if (block._type === 'youtube' || block._type === 'video' || block.url?.includes('youtube') || block.url?.includes('youtu.be')) {
        return (
          <div key={idx} class="my-6 not-prose">
            <YouTubeEmbed url={block.url || block.videoUrl} caption={block.caption || block.title} />
          </div>
        );
      }
      if (block._type === 'image') {
        const layoutStyle = block.layout || 'right';
        const isFloated = layoutStyle === 'left' || layoutStyle === 'right';
        const isOriginal = layoutStyle === 'original';
        const img = responsiveImage(block, isFloated ? [400, 600, 900] : [640, 960, 1280, 1600, 1920]);
        if (!img) return null;
        const floatClass = layoutStyle === 'left'
          ? 'float-none sm:float-left sm:mr-6 mb-6 w-full sm:w-1/2 max-w-md'
          : layoutStyle === 'right'
          ? 'float-none sm:float-right sm:ml-6 mb-6 w-full sm:w-1/2 max-w-md'
          : isOriginal
          ? 'my-8 inline-block'
          : 'w-full my-8';

        return (
          <figure key={idx} class={`not-prose ${floatClass} group`}>
            <a href={img.src} target="_blank" rel="noopener noreferrer" class="block relative overflow-hidden rounded-2xl border border-slate-200 shadow-md bg-slate-50 cursor-zoom-in">
              <img
                src={img.src}
                srcset={img.srcset}
                sizes={isFloated ? '(min-width: 640px) 448px, 100vw' : '100vw'}
                width={img.width}
                height={img.height}
                alt={block.alt || block.caption || 'Kuva'}
                loading="lazy"
                decoding="async"
                class={isOriginal
                  ? 'max-w-full h-auto object-contain rounded-2xl group-hover:scale-[1.01] transition-transform duration-300'
                  : 'w-full h-auto object-contain rounded-2xl group-hover:scale-[1.01] transition-transform duration-300 max-h-[450px]'}
              />
              <div class="absolute bottom-3 right-3 px-3 py-1.5 rounded-xl bg-slate-900/85 text-white text-xs font-semibold backdrop-blur-md opacity-90 group-hover:opacity-100 transition-opacity flex items-center gap-1.5 shadow-md">
                <span>Suurenna kuva 🔍</span>
              </div>
            </a>
            {block.caption && (
              <figcaption class={`text-xs sm:text-sm text-slate-600 mt-2 font-medium italic bg-slate-50/80 p-2 rounded-xl border border-slate-100 ${isOriginal ? 'text-left' : 'text-center'}`}>{block.caption}</figcaption>
            )}
          </figure>
        );
      }
      if (block._type === 'file' && block.fileUrl) {
        return (
          <div key={idx} class="my-6 p-4 sm:p-5 rounded-2xl bg-alajarvi-50 border border-alajarvi-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4 not-prose">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-alajarvi-500 text-white flex items-center justify-center shrink-0 shadow-sm">
                <FileText class="w-5 h-5" />
              </div>
              <div>
                <h4 class="font-bold text-alajarvi-900 text-sm">{block.description || 'Ladattava PDF-liitedokumentti'}</h4>
                <span class="text-xs text-slate-500">PDF / Ladattava tiedosto</span>
              </div>
            </div>
            <a
              href={block.fileUrl}
              target="_blank"
              download
              class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-alajarvi-500 hover:bg-alajarvi-600 text-white text-xs font-bold transition-all shadow-sm active:scale-95 shrink-0"
            >
              <Download class="w-4 h-4" />
              <span>Lataa tiedosto (PDF)</span>
            </a>
          </div>
        );
      }
      return null;
    })}
  </div>

) : (
  <div class="text-slate-600 leading-relaxed">
    {value ? String(value) : null}
  </div>
)}
