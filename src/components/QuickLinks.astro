---
import { getQuickLinks } from '../lib/sanity';
import { ExternalLink, GraduationCap, Utensils, BookOpen, Link2 } from 'lucide-astro';

const links = await getQuickLinks();
---

<section class="max-w-7xl mx-auto px-4 sm:px-8 -mt-8 relative z-20">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {links.map((item) => (
      <a
        href={item.url}
        target={item.url?.startsWith('/') ? '_self' : '_blank'}
        rel={item.url?.startsWith('/') ? undefined : 'noopener noreferrer'}
        class="group p-6 rounded-2xl bg-white shadow-xl shadow-slate-200/50 border border-slate-100 hover:border-alajarvi-300 hover:shadow-2xl hover:shadow-alajarvi-500/10 transition-all duration-300 flex items-center justify-between transform hover:-translate-y-1"
      >
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-alajarvi-50 text-alajarvi-600 group-hover:bg-alajarvi-500 group-hover:text-white transition-colors flex items-center justify-center shrink-0 shadow-inner">
            {item.icon === 'wilma' && <GraduationCap class="w-7 h-7" />}
            {item.icon === 'utensils' && <Utensils class="w-7 h-7" />}
            {item.icon === 'book-open' && <BookOpen class="w-7 h-7" />}
            {item.icon === 'link' && <Link2 class="w-7 h-7" />}
          </div>
          <div>
            <h3 class="font-display font-bold text-lg text-slate-800 group-hover:text-alajarvi-600 transition-colors">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 mt-0.5">{item.description || 'Avaa virallinen verkkopalvelu'}</p>

          </div>
        </div>

        <div class="w-9 h-9 rounded-full bg-slate-100 group-hover:bg-alajarvi-100 text-slate-400 group-hover:text-alajarvi-600 flex items-center justify-center transition-colors">
          <ExternalLink class="w-4 h-4" />
        </div>
      </a>
    ))}
  </div>
</section>
