---
interface Props {
  url: string;
  caption?: string;
  title?: string;
}

const { url, caption, title } = Astro.props;

function getEmbedUrl(rawUrl: string): string | null {
  if (!rawUrl) return null;
  const match = rawUrl.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
  return match ? `https://www.youtube-nocookie.com/embed/${match[1]}?rel=0&autoplay=0` : null;
}

const embedUrl = getEmbedUrl(url);
---

{embedUrl ? (
  <div class="space-y-2 group">
    <div class="relative w-full aspect-video rounded-3xl overflow-hidden shadow-lg border border-slate-200/90 bg-slate-900 group-hover:border-alajarvi-300 transition-all">
      <iframe
        src={embedUrl}
        title={title || caption || 'YouTube video player'}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        class="absolute top-0 left-0 w-full h-full border-0"
        loading="lazy"
      ></iframe>
    </div>
    {caption && (
      <p class="text-xs sm:text-sm text-slate-500 font-semibold text-center pt-1 px-2">
        {caption}
      </p>
    )}
  </div>
) : null}
