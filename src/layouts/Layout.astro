---
import '../styles/global.css';
import LightboxModal from '../components/LightboxModal.astro';
import CookieConsent from '../components/CookieConsent.astro';
import ContactFab from '../components/ContactFab.astro';

const gtmId = import.meta.env.PUBLIC_GTM_ID;

// Site is still being built out — flip this to true (and remove the noindex header in
// netlify.toml + the robots.txt Disallow) only when the school is ready to go fully public.
const SITE_IS_PUBLIC = false;

const SITE_NAME = 'Alajärven lukio';

// Real school identity for JSON-LD (kept in sync manually with siteSettings/contactInfo in
// Sanity — these change rarely, so fetching them per page render isn't worth the extra
// round-trip on every single request).
const SCHOOL_JSONLD = {
  '@context': 'https://schema.org',
  '@type': 'School',
  name: 'Alajärven lukio',
  url: 'https://alajarven-lukio-dev.netlify.app',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Kaupintie 7',
    postalCode: '62900',
    addressLocality: 'Alajärvi',
    addressCountry: 'FI',
  },
  telephone: '+358406739091',
  areaServed: 'Alajärvi',
};

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Alajärven lukio | Laadukasta ja yhteisöllistä lukio-opetusta',
  description = 'Alajärven lukio tarjoaa laadukasta ja monipuolista yleislukio-opetusta, vahvaa opinto-ohjausta ja laajoja kansainvälisyysmahdollisuuksia Alajärvellä.',
  image,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image ? new URL(image, Astro.site).toString() : undefined;
---

<!DOCTYPE html>
<html lang="fi">
  <head>
    <!-- Consent Mode v2: default state, set before any Google tag can load -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;

      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });

      try {
        var saved = JSON.parse(localStorage.getItem('cookie-consent-v1') || 'null');
        if (saved) gtag('consent', 'update', saved);
      } catch (e) {}
    </script>
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', gtmId);
      </script>
    )}

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {!SITE_IS_PUBLIC && (
      <>
        <!-- Hide site from search engines while content is still being finished -->
        <meta name="robots" content="noindex, nofollow" />
        <meta name="googlebot" content="noindex, nofollow" />
      </>
    )}

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fi_FI" />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    <!-- Structured data for search engines and AI answer engines (GEO) -->
    <script type="application/ld+json" set:html={JSON.stringify(SCHOOL_JSONLD)} />

    <!-- Google Fonts: preconnect + a non-render-blocking stylesheet load (fetched at low
    priority via media="print", then switched to "all" once loaded) — with display=swap the
    fallback font shows immediately either way, so there's no reason to block first paint on it. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />
    </noscript>
  </head>
  <body class="min-h-screen flex flex-col bg-[#F6FAFE] text-slate-800 antialiased selection:bg-alajarvi-500 selection:text-white overflow-x-clip w-full max-w-full relative">
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}

    <!-- Alvar Aalto Wave Background Overlay (Visible in page margins as soft gentle blue gradients) -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <!-- Top-Right Soft Blue Aalto Wave Flow (Visible in right margin) -->
      <div class="absolute top-0 -right-20 w-[600px] sm:w-[900px] h-[750px] opacity-85">
        <svg class="w-full h-full" viewBox="0 0 900 750" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M900 0C720 140 560 80 400 240C240 400 120 320 0 500V0H900Z" fill="url(#aalto-grad-1)"/>
          <defs>
            <linearGradient id="aalto-grad-1" x1="450" y1="0" x2="450" y2="500" gradientUnits="userSpaceOnUse">
              <stop stop-color="#4D82E0" stop-opacity="0.32"/>
              <stop offset="0.6" stop-color="#8AB2EE" stop-opacity="0.16"/>
              <stop offset="1" stop-color="#E0E9F5" stop-opacity="0.0"/>
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- Middle-Left Soft Aalto Wave Flow (Visible in left margin) -->
      <div class="absolute top-[25%] -left-36 w-[650px] sm:w-[950px] h-[800px] opacity-80">
        <svg class="w-full h-full" viewBox="0 0 950 800" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 200C200 140 360 320 560 250C760 180 850 340 950 270V800H0V200Z" fill="url(#aalto-grad-2)"/>
          <defs>
            <linearGradient id="aalto-grad-2" x1="475" y1="140" x2="475" y2="800" gradientUnits="userSpaceOnUse">
              <stop stop-color="#0046AD" stop-opacity="0.20"/>
              <stop offset="0.7" stop-color="#B8D0F5" stop-opacity="0.08"/>
              <stop offset="1" stop-color="#E0E9F5" stop-opacity="0.0"/>
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- Bottom-Right Soft Aalto Wave Flow (Visible near footer right margin) -->
      <div class="absolute bottom-0 -right-20 w-[700px] sm:w-[1000px] h-[650px] opacity-80">
        <svg class="w-full h-full" viewBox="0 0 1000 650" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1000 650H0C220 540 420 600 600 500C780 400 920 480 1000 380V650Z" fill="url(#aalto-grad-3)"/>
          <defs>
            <linearGradient id="aalto-grad-3" x1="500" y1="380" x2="500" y2="650" gradientUnits="userSpaceOnUse">
              <stop stop-color="#8AB2EE" stop-opacity="0.28"/>
              <stop offset="1" stop-color="#E0E9F5" stop-opacity="0.05"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
    </div>

    <div class="relative z-10 flex flex-col min-h-screen">
      <!-- Skip to content link for screen readers and keyboard accessibility -->
      <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-5 focus:py-3 focus:bg-alajarvi-900 focus:text-white focus:font-bold focus:rounded-xl focus:shadow-2xl focus:outline-none focus:ring-4 focus:ring-amber-400"
      >
        Siirry suoraan pääsisältöön (Skip to content)
      </a>
      <slot />
      <LightboxModal />
      <CookieConsent />
      <ContactFab />
    </div>
  </body>
</html>
