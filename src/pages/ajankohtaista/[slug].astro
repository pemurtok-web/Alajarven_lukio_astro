---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PortableText from '../../components/PortableText.astro';
import { getNewsBySlug, getAllNews, urlFor, retinaSrcSet } from '../../lib/sanity';
import { Calendar, ChevronRight, ArrowLeft, Share2, Tag } from 'lucide-astro';

export async function getStaticPaths() {
  const posts = await getAllNews();
  return posts.map((post) => ({
    params: { slug: post.slug.current },
  }));
}

const { slug } = Astro.params;
const post = await getNewsBySlug(slug as string);

if (!post) {
  return Astro.redirect('/ajankohtaista');
}

const mainImageUrl = post.mainImage ? urlFor(post.mainImage)?.width(1200).height(600).fit('crop').url() : undefined;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.title,
  datePublished: post.publishedAt,
  ...(post.excerpt ? { description: post.excerpt } : {}),
  ...(mainImageUrl ? { image: [mainImageUrl] } : {}),
  publisher: {
    '@type': 'Organization',
    name: 'Alajärven lukio',
  },
};
---

<Layout
  title={`${post.title} | Alajärven lukio`}
  description={post.excerpt || `${post.title} - Alajärven lukion uutinen.`}
  image={mainImageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <Header />

  <main class="py-12 bg-transparent min-h-[80vh]">
    <div class="max-w-4xl mx-auto px-4 sm:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-6">
        <a href="/" class="hover:text-alajarvi-600">Etusivu</a>
        <ChevronRight class="w-3.5 h-3.5" />
        <a href="/ajankohtaista" class="hover:text-alajarvi-600">Ajankohtaista</a>
        <ChevronRight class="w-3.5 h-3.5" />
        <span class="text-slate-800 truncate">{post.title}</span>
      </nav>

      <!-- Back Link -->
      <a href="/ajankohtaista" class="inline-flex items-center gap-2 text-xs font-bold text-alajarvi-600 hover:text-alajarvi-800 mb-6 transition-colors">
        <ArrowLeft class="w-4 h-4" />
        <span>Takaisin uutisarkistoon</span>
      </a>

      <!-- Article Header -->
      <article class="bg-white rounded-3xl overflow-hidden shadow-sm border border-slate-200/80">
        
        {post.mainImage && (
          <div class="h-64 sm:h-96 w-full bg-slate-800 relative">
            <img
              src={mainImageUrl || ''}
              srcset={retinaSrcSet(post.mainImage, 1200, 600)}
              width={1200}
              height={600}
              alt={post.title}
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover"
            />
          </div>
        )}

        <div class="p-8 sm:p-12 space-y-6">
          <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-slate-500 border-b border-slate-100 pb-4">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-alajarvi-100 text-alajarvi-700">
              <Calendar class="w-3.5 h-3.5" />
              {new Date(post.publishedAt).toLocaleDateString('fi-FI')}
            </span>
            <span class="text-slate-400">|</span>
            <span class="text-slate-600">Alajärven lukion tiedotteet</span>
          </div>

          <h1 class="font-display font-extrabold text-3xl sm:text-4xl text-alajarvi-900 leading-tight">
            {post.title}
          </h1>

          {post.excerpt && (
            <p class="text-lg font-medium text-slate-700 leading-relaxed italic border-l-4 border-alajarvi-500 pl-4 py-1">
              {post.excerpt}
            </p>
          )}

          <div class="pt-4 border-t border-slate-100">
            {post.body ? (
              <PortableText value={post.body} />
            ) : (
              <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed">
                <p>Alajärven lukion julkaisema uutinen. Lisätietoja saa lukion kansliasta tai ryhmänohjaajilta.</p>
              </div>
            )}
          </div>
        </div>

      </article>

    </div>
  </main>

  <Footer />
</Layout>
