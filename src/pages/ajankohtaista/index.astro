---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getAllNews, urlFor } from '../../lib/sanity';
import { Newspaper, Calendar, ArrowRight, ChevronRight, Search } from 'lucide-astro';

export const prerender = false;

const allPosts = await getAllNews();
---

<Layout title="Ajankohtaista - Uutisarkisto | Alajärven lukio">
  <Header />

  <main class="py-12 bg-slate-50 min-h-[80vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-6">
        <a href="/" class="hover:text-alajarvi-600">Etusivu</a>
        <ChevronRight class="w-3.5 h-3.5" />
        <span class="text-slate-800">Ajankohtaista & Uutisarkisto</span>
      </nav>

      <!-- Header Card -->
      <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-alajarvi-900 via-alajarvi-800 to-alajarvi-700 text-white shadow-xl mb-12 relative overflow-hidden">
        <div class="relative z-10 space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs font-semibold text-sky-200 border border-white/20">
            <Newspaper class="w-4 h-4 text-amber-300" />
            <span>Tiedotteet & Artikkelit</span>
          </div>
          <h1 class="font-display font-extrabold text-3xl sm:text-4xl text-white">
            Ajankohtaista Alajärven lukiossa
          </h1>
          <p class="text-base text-slate-200 max-w-2xl">
            Täältä löydät kaikki lukion julkaisemat uutiset, oppilasvalinnat, tiedotteet ja tapahtuma-artikkelit.
          </p>
        </div>
      </div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allPosts.map((item) => (
          <article class="group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl border border-slate-200/80 hover:border-alajarvi-200 transition-all duration-300 flex flex-col h-full transform hover:-translate-y-1">
            <div class="relative h-48 bg-gradient-to-br from-alajarvi-700 to-alajarvi-900 overflow-hidden">
              {item.mainImage ? (
                <img
                  src={urlFor(item.mainImage)?.width(600).height(400).url() || ''}
                  alt={item.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center p-6 text-center">
                  <Newspaper class="w-12 h-12 text-alajarvi-300/40" />
                </div>
              )}
              
              <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold text-alajarvi-800 flex items-center gap-1.5 shadow-sm">
                <Calendar class="w-3.5 h-3.5 text-alajarvi-500" />
                <span>{new Date(item.publishedAt).toLocaleDateString('fi-FI')}</span>
              </div>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-3">
                <h2 class="font-display font-bold text-lg text-slate-900 group-hover:text-alajarvi-600 transition-colors leading-snug">
                  <a href={`/ajankohtaista/${item.slug.current}`}>
                    {item.title}
                  </a>
                </h2>
                <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
                  {item.excerpt}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <a
                  href={`/ajankohtaista/${item.slug.current}`}
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-alajarvi-600 hover:text-alajarvi-800 transition-colors"
                >
                  <span>Lue koko uutinen</span>
                  <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </main>

  <Footer />
</Layout>
