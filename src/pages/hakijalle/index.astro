---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LongPageNav from '../../components/LongPageNav.astro';
import HeroWave from '../../components/HeroWave.astro';
import PortableText from '../../components/PortableText.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { getPageBySlug, urlFor, responsiveImage, extractPageAnchors } from '../../lib/sanity';
import { GraduationCap, CheckCircle, Sparkles, BookOpen, Globe, Award, HelpCircle, ArrowRight, FileText, Image as ImageIcon } from 'lucide-astro';

const page = await getPageBySlug('hakijalle');

const dynamicAnchors = extractPageAnchors(page);
const defaultAnchors = [
  { id: 'miksi-alajarven-lukio', label: '1. Miksi Alajärven lukio?' },
  { id: 'valintaperusteet', label: '2. Valintaperusteet' },
  { id: 'hakeminen', label: '3. Kuinka haetaan (Yhteishaku)' },
  { id: 'yhdistelmaopinnot', label: '4. Kaksoistutkinto & yhdistelmäopinnot' },
  { id: 'lukiolinjat', label: '5. Opintotarjonta & linjat' },
];

const anchors = dynamicAnchors.length > 0 ? dynamicAnchors : defaultAnchors;
const hasDynamicSections = page?.sections && page.sections.length > 0;
const heroImg = page?.heroBgImage ? responsiveImage(page.heroBgImage, [640, 960, 1280, 1600, 1920]) : null;
const mainImg = page?.mainImage ? responsiveImage(page.mainImage, [640, 960, 1280, 1600, 1920]) : null;
---

<Layout
  title={`${page?.title || 'Hakijalle'} | Alajärven lukio`}
  description={page?.lead || 'Tietoa hakemisesta Alajärven lukioon: valintaperusteet, yhteishaku ja opintotarjonta.'}
  image={heroImg?.src || mainImg?.src}
>
  <Header />

  <main class="bg-transparent">

    <!-- Page Hero — full-width, edge-to-edge (no rounded corners), flush against the
         header, with the flowing Aalto wave mask at the bottom. -->
    <div class="relative overflow-hidden bg-gradient-to-br from-alajarvi-900 via-alajarvi-800 to-[#045CD2] text-white">
      {page?.heroBgImage && urlFor(page.heroBgImage) && (
        <div class="absolute inset-0 z-0 pointer-events-none">
          <img
            src={heroImg?.src}
            srcset={heroImg?.srcset}
            sizes="100vw"
            width={heroImg?.width}
            height={heroImg?.height}
            alt={page.heroBgImage.alt || page?.title || 'Hero taustakuva'}
            class="w-full h-full object-cover object-center"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/55 to-slate-950/15"></div>
        </div>
      )}
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-alajarvi-500/10 rounded-full blur-3xl pointer-events-none z-0"></div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-8 py-10 sm:py-16 pb-20 sm:pb-28">
        <div class="space-y-4 max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md text-xs font-bold text-sky-200 border border-white/10 shadow-sm">
            <GraduationCap class="w-4 h-4 text-amber-400" />
            <span>Tule opiskelemaan meille</span>
          </div>
          <h1 class="font-display font-extrabold text-4xl sm:text-5xl text-white tracking-tight drop-shadow-sm">
            {page?.title || 'Tervetuloa Alajärven lukioon!'}
          </h1>
          <p class="text-lg text-slate-200 leading-relaxed font-normal max-w-2xl">
            {page?.lead || 'Alajärven lukio on turvallinen, kannustava ja korkeatasoinen lukio Etelä-Pohjanmaalla. Tältä sivulta löydät kaiken tarvittavan tiedon yhteishakuun ja opintojen aloittamiseen.'}
          </p>
        </div>
      </div>
      <HeroWave />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-8 py-8">

      <!-- Main Page Image (Full Resolution Sharp View) -->
      {page?.mainImage && urlFor(page.mainImage) && (
        <div class="overflow-hidden rounded-3xl bg-white border border-slate-200/80 shadow-xl group">
          <div class="relative overflow-hidden">
            <img
              src={mainImg?.src}
              srcset={mainImg?.srcset}
              sizes="(min-width: 1024px) 1024px, 100vw"
              width={mainImg?.width}
              height={mainImg?.height}
              alt={page.mainImage.alt || page?.title || 'Alajärven lukion ilmakuva'}
              class="w-full h-auto object-cover max-h-[42vh] lg:max-h-[520px] w-full"
              loading="lazy"
              decoding="async"
            />
            {page.mainImage.caption && (
              <div class="p-4 bg-slate-900/90 text-white text-xs sm:text-sm backdrop-blur-md border-t border-white/10">
                {page.mainImage.caption}
              </div>
            )}
          </div>
        </div>
      )}

      <!-- External Google Drive / Document Link Banner -->
      {page?.externalLink && (
        <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-alajarvi-800 to-alajarvi-900 text-white shadow-lg flex flex-col sm:flex-row sm:items-center justify-between gap-6 border border-alajarvi-700">
          <div class="space-y-1">
            <div class="inline-flex items-center gap-2 text-xs font-bold text-amber-300 uppercase tracking-wider">
              <Sparkles class="w-4 h-4" />
              <span>Tärkeä verkkolinkki / Materiaali</span>
            </div>
            <h4 class="font-bold text-white text-base sm:text-lg">{page.externalLinkTitle || 'Avaa Opinto-opas Google Drivessa'}</h4>
            <p class="text-xs text-slate-300">Siirry tarkastelemaan suoraa Google Drive -opasta tai verkkodokumenttia.</p>
          </div>
          <a
            href={page.externalLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-white hover:bg-slate-100 text-alajarvi-900 font-extrabold text-sm transition-all shadow-md active:scale-95 shrink-0"
          >
            <span>{page.externalLinkTitle || 'Avaa linkki'}</span>
            <ArrowRight class="w-4 h-4 text-alajarvi-600" />
          </a>
        </div>
      )}

      {page?.youtubeUrl && (
        <div class="my-6">
          <YouTubeEmbed url={page.youtubeUrl} title={page?.youtubeTitle || 'Katso lukion esittelyvideo'} caption={page?.youtubeCaption} />
        </div>
      )}

      {page?.body && page.body.length > 0 && (
        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-sm border border-slate-200/80">
          <PortableText value={page.body} />
        </div>
      )}

      <!-- Sticky Anchor Links Bar -->
      <LongPageNav anchors={anchors} title="Hakijalle - Sisällysluettelo" />

      <!-- Long Page Sections -->
      {hasDynamicSections ? (
        <div class="space-y-8">
          {page.sections.map((sec: any, idx: number) => {
            const secId = sec.anchorId || `miksi-alajarven-lukio`;
            const secImage = sec.image;
            const imageUrl = secImage?.src || (secImage?.asset ? urlFor(secImage)?.width(1600).quality(85).url() : null);
            const secImgResponsive = !secImage?.src && secImage?.asset ? responsiveImage(secImage, [400, 640, 828, 1080]) : null;
            const secTitle = typeof sec.title === 'string' ? sec.title.replace(/^\d+\.\s*/, '') : sec.title;

            return (
              <section
                id={secId}
                class="scroll-mt-28 p-6 sm:p-8 md:p-10 rounded-3xl bg-white shadow-md border border-slate-200/90 hover:border-alajarvi-300 transition-all space-y-6"
                style="scroll-margin-top: var(--anchor-offset, 112px)"
              >
                <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
                  <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-alajarvi-600 to-alajarvi-800 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-sm">
                    {idx + 1}
                  </div>
                  <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
                    {secTitle}
                  </h2>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
                  <div class={`text-slate-700 leading-relaxed text-base space-y-4 ${imageUrl && idx % 2 === 1 ? 'lg:order-2' : 'lg:order-1'}`}>
                    {sec.content ? (
                      <PortableText value={sec.content} />
                    ) : (
                      <p>Sisältöä päivitetään.</p>
                    )}

                    {/* Stats cards inside section 2 / valintaperusteet */}
                    {idx === 1 && page?.stats && page.stats.length > 0 && (
                      <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
                        {page.stats.map((st: any) => (
                          <div>
                            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block">{st.label}</span>
                            <span class="text-3xl font-extrabold font-display text-alajarvi-700">{st.number}</span>
                            {st.description && <p class="text-xs text-slate-600 mt-1">{st.description}</p>}
                          </div>
                        ))}
                      </div>
                    )}

                    {/* Features cards inside section 1 / miksi alajarven lukio */}
                    {idx === 0 && page?.features && page.features.length > 0 && (
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2 mt-4">
                        {page.features.map((feat: any) => (
                          <div class="p-5 rounded-2xl bg-alajarvi-50/60 border border-alajarvi-100 space-y-2">
                            <div class="flex items-center gap-2 font-bold text-alajarvi-900">
                              {feat.icon === 'globe' ? (
                                <Globe class="w-5 h-5 text-amber-500" />
                              ) : (
                                <CheckCircle class="w-5 h-5 text-alajarvi-500" />
                              )}
                              <span>{feat.title}</span>
                            </div>
                            <p class="text-xs text-slate-600 leading-relaxed">{feat.description}</p>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>

                  {imageUrl && (
                    <div class={`w-full flex flex-col justify-center ${idx % 2 === 1 ? 'lg:order-1' : 'lg:order-2'}`}>
                      <div class="group relative rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-slate-50">
                        <a href={imageUrl} target="_blank" rel="noopener noreferrer" class="block relative cursor-zoom-in overflow-hidden">
                          <img
                            src={secImgResponsive?.src || imageUrl}
                            srcset={secImgResponsive?.srcset}
                            sizes="(min-width: 1024px) 50vw, 100vw"
                            width={secImgResponsive?.width}
                            height={secImgResponsive?.height}
                            alt={secImage?.alt || sec.title}
                            loading="lazy"
                            decoding="async"
                            class="w-full h-auto max-h-[360px] object-cover rounded-t-2xl group-hover:scale-[1.02] transition-transform duration-300"
                          />
                          <div class="absolute bottom-3 right-3 px-3 py-1.5 rounded-xl bg-slate-900/85 text-white text-xs font-semibold backdrop-blur-md opacity-90 group-hover:opacity-100 transition-opacity flex items-center gap-1.5 shadow-md">
                            <span>Avaa kuva 🔍</span>
                          </div>
                        </a>
                        {secImage?.caption && (
                          <div class="p-3 bg-white border-t border-slate-100 text-xs text-slate-600 font-medium text-center">
                            {secImage.caption}
                          </div>
                        )}
                      </div>
                    </div>
                  )}
                </div>
              </section>
            );
          })}
        </div>
      ) : (
        <div class="space-y-12">
          <!-- Section 1: Miksi Alajärven lukio -->
          <section id="miksi-alajarven-lukio" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6" style="scroll-margin-top: var(--anchor-offset, 112px)">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
                1
              </div>
              <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
                Miksi valita juuri Alajärven lukio?
              </h2>
            </div>

            <p class="text-slate-700 leading-relaxed text-base">
              Alajärven lukio tunnetaan hyvästä yhteishengestään, omistautuneista opettajistaan ja korkeista opiskelutuloksistaan. Pienessä ja ketterässä lukiossa et huku massaan – saat yksilöllistä ohjausta ja tukea joka vaiheessa.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
              <div class="p-5 rounded-2xl bg-alajarvi-50/60 border border-alajarvi-100 space-y-2">
                <div class="flex items-center gap-2 font-bold text-alajarvi-900">
                  <CheckCircle class="w-5 h-5 text-alajarvi-500" />
                  <span>Maksuton 2. asteen koulutus</span>
                </div>
                <p class="text-xs text-slate-600 leading-relaxed">
                  Opiskelijamme saavat oppikirjat, kannettavan tietokoneen ja muut oppimateriaalit veloituksetta oppivelvollisuuslain mukaisesti.
                </p>
              </div>

              <div class="p-5 rounded-2xl bg-alajarvi-50/60 border border-alajarvi-100 space-y-2">
                <div class="flex items-center gap-2 font-bold text-alajarvi-900">
                  <Globe class="w-5 h-5 text-amber-500" />
                  <span>Aito kansainvälisyys</span>
                </div>
                <p class="text-xs text-slate-600 leading-relaxed">
                  Lukion pitkäaikainen yhteistyö Japanin Jiyu Gakuen -koulun ja Mukawan kaupungin kanssa avaa ainutlaatuisia vaihtomahdollisuuksia.
                </p>
              </div>
            </div>
          </section>

          <!-- Section 2: Valintaperusteet -->
          <section id="valintaperusteet" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6" style="scroll-margin-top: var(--anchor-offset, 112px)">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
                2
              </div>
              <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
                Valintaperusteet ja keskiarvoraja
              </h2>
            </div>

            <p class="text-slate-700 leading-relaxed">
              Alajärven lukioon haetaan lukuaineiden keskiarvon perusteella valtakunnallisessa yhteishaussa.
            </p>

            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Yleislinjan keskiarvoraja</span>
                <span class="text-3xl font-extrabold font-display text-alajarvi-700">7,00</span>
                <p class="text-xs text-slate-600 mt-1">Peruskoulun päättötodistuksen lukuaineiden keskiarvo.</p>
              </div>
              <div>
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Aloituspaikat</span>
                <span class="text-3xl font-extrabold font-display text-alajarvi-700">n. 60–70</span>
                <p class="text-xs text-slate-600 mt-1">Aloituspaikkoja tarkistetaan vuosittain tarpeen mukaan.</p>
              </div>
            </div>
          </section>

          <!-- Section 3: Kuinka haetaan -->
          <section id="hakeminen" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6" style="scroll-margin-top: var(--anchor-offset, 112px)">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
                3
              </div>
              <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
                Kuinka haetaan (Yhteishaku)
              </h2>
            </div>

            <p class="text-slate-700 leading-relaxed">
              Haku lukioon tapahtuu osoitteessa <a href="https://opintopolku.fi" target="_blank" class="text-alajarvi-600 font-bold underline">Opintopolku.fi</a> kevään yhteishaun aikana (helmi-maaliskuussa).
            </p>

            <div class="space-y-4">
              <div class="flex items-start gap-4 p-4 rounded-xl bg-slate-50">
                <span class="w-8 h-8 rounded-full bg-alajarvi-500 text-white font-bold flex items-center justify-center shrink-0 text-sm">1</span>
                <div>
                  <h4 class="font-bold text-slate-900">Täytä yhteishakulomake Opintopolussa</h4>
                  <p class="text-xs text-slate-600">Valitse ensimmäiseksi hakutoiveeksesi Alajärven lukio.</p>
                </div>
              </div>

              <div class="flex items-start gap-4 p-4 rounded-xl bg-slate-50">
                <span class="w-8 h-8 rounded-full bg-alajarvi-500 text-white font-bold flex items-center justify-center shrink-0 text-sm">2</span>
                <div>
                  <h4 class="font-bold text-slate-900">Tiedotustilaisuudet ja tutustumisopastukset</h4>
                  <p class="text-xs text-slate-600">Alajärven ja lähikuntien 9.-luokkalaisille järjestetään tutustumispäivät lukiolla.</p>
                </div>
              </div>

              <div class="flex items-start gap-4 p-4 rounded-xl bg-slate-50">
                <span class="w-8 h-8 rounded-full bg-alajarvi-500 text-white font-bold flex items-center justify-center shrink-0 text-sm">3</span>
                <div>
                  <h4 class="font-bold text-slate-900">Valintojen tulokset ja paikan vastaanottaminen</h4>
                  <p class="text-xs text-slate-600">Tulokset julkaistaan kesäkuussa. Vahvista opiskelupaikka sähköisesti.</p>
                </div>
              </div>
            </div>
          </section>

          <!-- Section 4: Kaksoistutkinto & yhdistelmäopinnot -->
          <section id="yhdistelmaopinnot" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6" style="scroll-margin-top: var(--anchor-offset, 112px)">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
                4
              </div>
              <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
                Kaksoistutkinto & yhdistelmäopinnot
              </h2>
            </div>

            <p class="text-slate-700 leading-relaxed">
              Voit yhdistää joustavasti lukio-opintojasi ammatilliseen perustutkintoon (JAMI). Kaksoistutkinnossa suoritat sekä ammatillisen tutkinnon että ylioppilastutkinnon.
            </p>
          </section>

          <!-- Section 5: Opintotarjonta & linjat -->
          <section id="lukiolinjat" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6" style="scroll-margin-top: var(--anchor-offset, 112px)">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
                5
              </div>
              <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
                Monipuoliset opintopolut
              </h2>
            </div>

            <p class="text-slate-700 leading-relaxed">
              Alajärven lukiossa voit syventää osaamistasi matemaattis-luonnontieteellisissä aineissa, vieraissa kielissä, humanistisissa aineissa sekä liikunnassa ja taiteissa.
            </p>
          </section>
        </div>
      )}

      {/* Gallery images section if added in Sanity */}
      {page?.gallery && page.gallery.length > 0 && (
        <div class="space-y-4 pt-4">
          <h3 class="font-bold text-slate-900 text-base flex items-center gap-2">
            <ImageIcon class="w-5 h-5 text-alajarvi-600" />
            <span>Kuvagalleria & Lisäkuvat ({page.gallery.length})</span>
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {page.gallery.map((img: any) => {
              const galleryImgUrl = urlFor(img)?.width(1920).quality(85).url();
              const galleryImg = responsiveImage(img, [400, 640, 828, 1080]);
              if (!galleryImgUrl) return null;
              return (
                <div class="group relative rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-white flex flex-col justify-between hover:shadow-lg transition-all">
                  <a href={galleryImgUrl} target="_blank" rel="noopener noreferrer" class="block relative cursor-zoom-in overflow-hidden bg-slate-50">
                    <img
                      src={galleryImg?.src || galleryImgUrl}
                      srcset={galleryImg?.srcset}
                      sizes="(min-width: 640px) 50vw, 100vw"
                      width={galleryImg?.width}
                      height={galleryImg?.height}
                      alt={img.alt || img.caption || 'Kuva'}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-auto object-contain rounded-t-2xl group-hover:scale-[1.01] transition-transform duration-300 max-h-[400px]"
                    />
                    <div class="absolute bottom-3 right-3 px-3 py-1.5 rounded-xl bg-slate-900/85 text-white text-xs font-semibold backdrop-blur-md opacity-90 group-hover:opacity-100 transition-opacity flex items-center gap-1.5 shadow-md">
                      <span>Suurenna 🔍</span>
                    </div>
                  </a>
                  {img.caption && (
                    <div class="p-3.5 bg-white border-t border-slate-100 text-xs text-slate-700 font-semibold text-center">
                      {img.caption}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      )}

      <!-- PDF files section if added in Sanity -->
      {page?.pdfFiles && page.pdfFiles.length > 0 && (
        <div class="space-y-4 pt-4">
          <h3 class="font-bold text-slate-900 text-base flex items-center gap-2">
            <FileText class="w-5 h-5 text-alajarvi-600" />
            <span>Ladattavat liitedokumentit & PDF-tiedostot</span>
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {page.pdfFiles.map((file: any) => (
              file.fileUrl && (
                <a
                  href={file.fileUrl}
                  target="_blank"
                  download
                  class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-alajarvi-300 shadow-sm hover:shadow-md flex items-center justify-between gap-3 group transition-all"
                >
                  <div>
                    <h4 class="font-bold text-slate-900 text-sm group-hover:text-alajarvi-600 transition-colors">{file.title || 'Ladattava PDF'}</h4>
                    {file.description && <p class="text-xs text-slate-500 mt-0.5">{file.description}</p>}
                  </div>
                  <FileText class="w-5 h-5 text-alajarvi-500 shrink-0 group-hover:scale-110 transition-transform" />
                </a>
              )
            ))}
          </div>
        </div>
      )}

    </div>
  </main>

  <Footer />
</Layout>
