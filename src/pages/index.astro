---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import QuickLinks from '../components/QuickLinks.astro';
import NewsHighlights from '../components/NewsHighlights.astro';
import EventCalendar from '../components/EventCalendar.astro';
import { Award, BookOpen, Compass, CheckCircle2, ArrowRight, Phone } from 'lucide-astro';
import { getHomepage, responsiveImage } from '../lib/sanity';

const homepage = await getHomepage();
const introImg = homepage.introImage ? responsiveImage(homepage.introImage, [400, 600, 800, 1000]) : null;
const features = (homepage.features && homepage.features.length > 0)
  ? homepage.features
  : [
      { title: 'Maksuttomat oppimateriaalit', description: 'Kaikki tietokoneet, oppikirjat ja yo-ilmoittautumiset maksutta.' },
      { title: 'Japanin vaihto-ohjelma', description: 'Mahdollisuus osallistua ainutlaatuiseen Jiyu Gakuen -yhteistyöhön.' },
      { title: 'Monipuolinen yhdistelmä tutkintoja', description: 'Mahdollisuus yhdistää lukio-opintoja ammatilliseen tutkintoon.' },
      { title: 'Korkeakouluyhteistyö', description: 'Väyläopintoja ja kurssikurkkauksia yliopistoihin ja amk:eihin.' }
    ];

const gridColsClass =
  features.length >= 8
    ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-4'
    : features.length === 6 || features.length === 3 || features.length === 5 || features.length === 7
    ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3'
    : features.length === 4
    ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-4'
    : features.length === 2
    ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-2'
    : 'grid-cols-1 max-w-md mx-auto';
---

<Layout
  title="Alajärven lukio | Etusivu"
  description={homepage.introDescription || homepage.heroDescription || 'Alajärven lukio tarjoaa laadukasta ja monipuolista yleislukio-opetusta, vahvaa opinto-ohjausta ja laajoja kansainvälisyysmahdollisuuksia Alajärvellä.'}
  image={introImg?.src}
>
  <Header />

  <main id="main-content" tabindex="-1" class="focus:outline-none">
    <!-- Hero Section -->
    <Hero
      badge={homepage.heroBadge}
      title={homepage.heroTitle}
      description={homepage.heroDescription}
      heroBgImage={homepage.heroBgImage}
      heroBgImageMobile={homepage.heroBgImageMobile}
      heroImage={homepage.heroImage}
    />

    <!-- Dynamic Quicklinks -->
    <QuickLinks />

    <!-- News Highlights Section -->
    <NewsHighlights />

    <!-- Event Calendar Section -->
    <EventCalendar />

    <!-- Esittelyosio & Valttikortit -->
    <section class="py-16 sm:py-20 bg-transparent border-y border-slate-200/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">

        <!-- Top Header & Intro Image Box -->
        <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-slate-200/80">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <!-- Text Column -->
            <div class="lg:col-span-7 space-y-5">
              <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-alajarvi-100 text-alajarvi-700 text-xs font-bold uppercase tracking-wider">
                <Compass class="w-4 h-4 text-alajarvi-600" />
                <span>{homepage.introBadge || 'Miksi valita Alajärven lukio?'}</span>
              </div>

              <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-alajarvi-900 tracking-tight leading-snug">
                {homepage.introTitle || 'Moderni lukio, jossa sinun tavoitteesi ovat keskiössä'}
              </h2>

              <p class="text-slate-600 text-base leading-relaxed">
                {homepage.introDescription || 'Alajärven lukio tarjoaa erinomaiset puitteet yleissivistävälle lukio-opiskelulle. Meillä yhdistyvät monipuolinen opintotarjotin, joustavat opintopolut sekä innostavat oppimisympäristöt.'}
              </p>

              <div class="pt-2">
                <a
                  href="/hakijalle"
                  class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-alajarvi-500 hover:bg-alajarvi-600 text-white font-semibold text-sm shadow-md transition-all hover:translate-x-0.5"
                >
                  <span>Lue lisää hakemisesta ja opiskelusta</span>
                  <ArrowRight class="w-4 h-4" />
                </a>
              </div>
            </div>

            <!-- Image Column -->
            <div class="lg:col-span-5">
              {introImg ? (
                <div class="group relative rounded-2xl overflow-hidden shadow-md border border-slate-200">
                  <img
                    src={introImg.src}
                    srcset={introImg.srcset}
                    sizes="(min-width: 1024px) 40vw, 90vw"
                    width={introImg.width}
                    height={introImg.height}
                    alt="Esittelykuva Alajärven lukiolta"
                    loading="lazy"
                    decoding="async"
                    class="w-full aspect-[16/10] lg:aspect-[4/3] max-h-[38vh] lg:max-h-[480px] object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
                  <div class="absolute bottom-4 left-4 right-4 text-white space-y-1">
                    <span class="inline-block px-2.5 py-0.5 rounded-full bg-white/20 text-[11px] font-semibold backdrop-blur-md border border-white/20">
                      Alvar Aallon kaupunki
                    </span>
                    <p class="font-bold text-sm text-white drop-shadow">Inspiroiva ympäristö oppimiselle ja kasvulle</p>
                  </div>
                </div>
              ) : (
                <div class="aspect-[16/10] lg:aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-br from-alajarvi-700 to-alajarvi-900 p-6 text-white flex flex-col justify-between shadow-md">
                  <span class="inline-block px-3 py-1 rounded-full bg-white/20 text-xs font-semibold backdrop-blur-md w-max border border-white/20">
                    Alvar Aallon kaupunki
                  </span>
                  <div class="space-y-1">
                    <h3 class="font-display font-extrabold text-xl text-white">
                      Inspiroiva ympäristö oppimiselle ja kasvulle
                    </h3>
                    <p class="text-xs text-slate-200">Pienet ryhmäkoot ja korkea laatu takaavat parhaan tuen jokaiselle opiskelijalle.</p>
                  </div>
                </div>
              )}
            </div>

          </div>
        </div>

        <!-- Feature Cards Section (Valttikortit) -->
        <div class="space-y-6">
          <div class="flex items-center justify-between border-b border-slate-200/80 pb-3">
            <div>
              <h3 class="font-display font-bold text-2xl text-slate-900">Lukion valttikortit</h3>
              <p class="text-slate-500 text-xs sm:text-sm">Tutustu opiskelun etuihin ja monipuolisiin mahdollisuuksiin Alajärvellä</p>
            </div>
          </div>

          <!-- Dynamic grid adapting smoothly to card counts -->
          <div class={`grid ${gridColsClass} gap-6 items-stretch`}>
            {features.map((feat: any) => {
              const featImg = feat.image ? responsiveImage(feat.image, [300, 500, 700]) : null;
              const activeListItems = feat.listItems
                ?.map((i: any) => (typeof i === 'string' ? i.trim() : ''))
                .filter((i: string) => i.length > 0) || [];

              return (
                <div class="group flex flex-col rounded-2xl bg-white border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-alajarvi-300 transition-all duration-300 overflow-hidden h-full">
                  {featImg && (
                    <div class="relative w-full aspect-[16/10] overflow-hidden bg-slate-100 shrink-0 border-b border-slate-100">
                      <img
                        src={featImg.src}
                        srcset={featImg.srcset}
                        sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw"
                        width={featImg.width}
                        height={featImg.height}
                        alt={feat.image?.alt || feat.title || 'Valttikortin kuva'}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                    </div>
                  )}

                  <div class="p-5 flex-grow flex flex-col justify-between space-y-3">
                    <div class="space-y-2.5">
                      <div class="flex items-start gap-2.5">
                        <CheckCircle2 class="w-5 h-5 text-alajarvi-500 shrink-0 mt-0.5" />
                        <h4 class="font-bold text-base text-slate-900 leading-snug">{feat.title}</h4>
                      </div>

                      {activeListItems.length > 0 ? (
                        <ul class="space-y-1.5 text-base text-slate-700 pt-1 pl-1">
                          {activeListItems.map((item: string) => (
                            <li class="flex items-start gap-1.5 font-medium">
                              <span class="text-alajarvi-500 font-bold shrink-0">•</span>
                              <span>{item}</span>
                            </li>
                          ))}
                        </ul>
                      ) : feat.description && feat.description.includes('\n') ? (
                        <div class="space-y-1.5 text-base text-slate-700 pt-1 pl-1">
                          {feat.description.split('\n').map((line: string, idx: number) => {
                            const trimmed = line.trim();
                            if (!trimmed) return null;
                            const isLead = idx === 0 && !/^[-•*]/.test(trimmed);
                            if (isLead) {
                              return <p class="font-semibold text-slate-800 pb-1 leading-snug">{trimmed}</p>;
                            }
                            return (
                              <div class="flex items-start gap-1.5 font-medium text-slate-700">
                                <span class="text-alajarvi-500 font-bold shrink-0">•</span>
                                <span>{trimmed.replace(/^[-•*]\s*/, '')}</span>
                              </div>
                            );
                          })}
                        </div>
                      ) : (
                        <p class="text-base text-slate-700 leading-relaxed font-medium whitespace-pre-line pl-1">{feat.description}</p>
                      )}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

      </div>
    </section>
  </main>

  <!-- Floating quick-access button to Yhteystiedot — always reachable, especially on mobile -->
  <a
    href="/yhteystiedot"
    class="fixed bottom-5 right-5 z-40 inline-flex items-center gap-2 pl-4 pr-5 py-3.5 rounded-full bg-alajarvi-500 hover:bg-alajarvi-600 text-white font-bold text-sm shadow-xl shadow-alajarvi-900/25 transition-all hover:scale-105 active:scale-95"
    style="padding-bottom: calc(0.875rem + env(safe-area-inset-bottom))"
    aria-label="Ota yhteyttä"
  >
    <Phone class="w-5 h-5 shrink-0" />
    <span>Ota yhteyttä</span>
  </a>

  <Footer />
</Layout>
