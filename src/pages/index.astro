---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import QuickLinks from '../components/QuickLinks.astro';
import NewsHighlights from '../components/NewsHighlights.astro';
import EventCalendar from '../components/EventCalendar.astro';
import { Award, BookOpen, Compass, CheckCircle2, ArrowRight } from 'lucide-astro';
import { getHomepage, urlFor } from '../lib/sanity';

const homepage = await getHomepage();
const introImgUrl = homepage.introImage ? urlFor(homepage.introImage)?.width(800).url() : null;
const features = (homepage.features && homepage.features.length > 0)
  ? homepage.features
  : [
      { title: 'Maksuttomat oppimateriaalit', description: 'Kaikki tietokoneet, oppikirjat ja yo-ilmoittautumiset maksutta.' },
      { title: 'Japanin vaihto-ohjelma', description: 'Mahdollisuus osallistua ainutlaatuiseen Jiyu Gakuen -yhteistyöhön.' },
      { title: 'Monipuolinen yhdistelmä tutkintoja', description: 'Mahdollisuus yhdistää lukio-opintoja ammatilliseen tutkintoon.' },
      { title: 'Korkeakouluyhteistyö', description: 'Väyläopintoja ja kurssikurkkauksia yliopistoihin ja amk:eihin.' }
    ];
---

<Layout title="Alajärven lukio | Etusivu">
  <Header />

  <main id="main-content" tabindex="-1" class="focus:outline-none">
    <!-- Hero Section -->
    <Hero
      badge={homepage.heroBadge}
      title={homepage.heroTitle}
      description={homepage.heroDescription}
      heroBgImage={homepage.heroBgImage}
      heroImage={homepage.heroImage}
    />

    <!-- Dynamic Quicklinks -->
    <QuickLinks />

    <!-- Esittelyosio (Kuva + Teksti rinnakkain) -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <!-- Image Column (5 cols) -->
          <div class="lg:col-span-5">
            <div class="relative">
              {introImgUrl ? (
                <img src={introImgUrl} alt="Esittelykuva" class="w-full aspect-[4/5] object-cover rounded-3xl shadow-2xl relative z-10" />
              ) : (
                <div class="aspect-[4/5] rounded-3xl overflow-hidden bg-gradient-to-br from-alajarvi-700 to-alajarvi-900 p-8 text-white flex flex-col justify-between shadow-2xl relative z-10">
                  <div class="space-y-2">
                    <span class="inline-block px-3 py-1 rounded-full bg-white/20 text-xs font-semibold backdrop-blur-md">
                      Alvar Aallon kaupunki
                    </span>
                    <h3 class="font-display font-extrabold text-2xl text-white">
                      Inspiroiva ympäristö oppimiselle ja kasvulle
                    </h3>
                  </div>

                  <div class="space-y-4">
                    <div class="p-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 text-xs space-y-1">
                      <p class="font-bold text-sky-200">Korkeat tulokset yo-kirjoituksissa</p>
                      <p class="text-slate-200">Alajärven lukiosta valmistuu vuosittain monipuolisia ja laaja-alaisia osaajia jatko-opintoihin.</p>
                    </div>
                    <div class="p-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 text-xs space-y-1">
                      <p class="font-bold text-amber-200">Vahva yhteisöhenki</p>
                      <p class="text-slate-200">Pienet ryhmäkoot takaavat sen, että jokainen opiskelija tunnetaan ja tukea on aina saatavilla.</p>
                    </div>
                  </div>
                </div>
              )}


              <!-- Decorative Backdrop Blur Elements -->
              <div class="absolute -bottom-6 -right-6 w-full h-full rounded-3xl bg-alajarvi-100 -z-10"></div>
            </div>
          </div>

          <!-- Text Column (7 cols) -->
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-alajarvi-100 text-alajarvi-700 text-xs font-bold uppercase tracking-wider">
              <Compass class="w-3.5 h-3.5" />
              <span>{homepage.introBadge || 'Miksi valita Alajärven lukio?'}</span>
            </div>

            <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-alajarvi-900 tracking-tight leading-snug">
              {homepage.introTitle || 'Moderni lukio, jossa sinun tavoitteesi ovat keskiössä'}
            </h2>

            <p class="text-slate-600 text-base leading-relaxed">
              {homepage.introDescription || 'Alajärven lukio tarjoaa erinomaiset puitteet yleissivistävälle lukio-opiskelulle. Meillä yhdistyvät monipuolinen opintotarjotin, joustavat opintopolut sekä innostavat oppimisympäristöt.'}
            </p>


            <!-- Feature Points -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              {features.map((feat: any) => (
                <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
                  <CheckCircle2 class="w-5 h-5 text-alajarvi-500 shrink-0 mt-0.5" />
                  <div>
                    <h4 class="font-bold text-sm text-slate-800">{feat.title}</h4>
                    <p class="text-xs text-slate-500">{feat.description}</p>
                  </div>
                </div>
              ))}
            </div>

            <div class="pt-4">
              <a
                href="/hakijalle"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-alajarvi-500 hover:bg-alajarvi-600 text-white font-semibold text-sm shadow-md transition-all"
              >
                <span>Lue lisää hakemisesta ja opiskelusta</span>
                <ArrowRight class="w-4 h-4" />
              </a>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- News Highlights Section -->
    <NewsHighlights />

    <!-- Event Calendar Section -->
    <EventCalendar />
  </main>

  <Footer />
</Layout>
