---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LongPageNav from '../../components/LongPageNav.astro';
import PortableText from '../../components/PortableText.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { getPageBySlug, urlFor, extractPageAnchors, splitBodyIntoCards } from '../../lib/sanity';
import { Globe, ChevronRight, Compass, Heart, Users, Image as ImageIcon, ExternalLink, FileText } from 'lucide-astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'jiyu-gakuen' } },
    { params: { slug: 'mukawa' } },
    { params: { slug: 'muu' } },
  ];
}

const { slug } = Astro.params;
const page = await getPageBySlug(slug as string);

const anchors = extractPageAnchors(page);
const isCardsLayout = page?.layoutStyle ? page.layoutStyle === 'cards' : (slug === 'jiyu-gakuen' || slug === 'mukawa');
const bodyCards = page?.body ? splitBodyIntoCards(page.body) : [];

const defaultDetails: Record<string, { title: string; subtitle: string; lead?: string; contentHTML?: string; sections?: any[]; gallery?: any[]; cards?: any[] }> = {
  'jiyu-gakuen': {
    title: 'Jiyu Gakuen (Tokio)',
    subtitle: 'Alajärven ja Vimpelin lukioiden opiskelijavaihto tokiolaisen Jiyu Gakuen -yhteistyökoulun kanssa.',
    lead: 'Jiyu Gakuenin opiskelijat tutustumassa Alvar Aallon arkkitehtuuriin Alajärvellä elokuussa 2024. Kierroksella olivat mukana kansainvälisyyskerhon opiskelijat.',
    cards: [
      {
        type: 'section',
        title: 'Opiskelijavaihtoa vuodesta 2016',
        contentHTML: `<p class="text-slate-700 leading-relaxed">Kansainväliset kohtaamiset ovat osa Alajärven lukion arkea. Alajärven ja Vimpelin lukiot ovat toteuttaneet opiskelijavaihtoa tokiolaisen yhteistyökoulun, Jiyu Gakuenin, kanssa jo vuodesta 2016. Joka kevätlukukausi kaksi Alajärven ja kaksi Vimpelin opiskelijaa lähtevät kahdeksi viikoksi vaihtoon Tokioon, jossa he majoittuvat isäntäperheissä ja osallistuvat koulun arkeen päivittäin. Vastaavasti Jiyu Gakuenista saapuu vuorovuosin Alajärven ja Vimpelin lukioon neljä vaihto-opiskelijaa kahdeksi viikoksi elokuussa. Yhteistyö on saanut alkunsa Silta Japaniin -hankkeesta, jonka toteutti Alajärven sivistystoimi yhdessä FJCE:n (Finland Japan Culture and Education ry) kanssa.</p>`
      },
      {
        type: 'image',
        src: '/images/jiyu-exact-1.jpg',
        caption: 'Helmiina Kuoppa-Aho englannin keskustelutunnilla Jiyu Gakuenissa huhtikuussa 2023.',
        alt: 'Helmiina Kuoppa-Aho Jiyu Gakuenissa'
      },
      {
        type: 'section',
        title: 'Vaihtoon?',
        contentHTML: `<p class="text-slate-700 leading-relaxed">Vaihto on opiskelijalle maksuton. Se sisältää lennot Japaniin, majoituksen ja ruokailut isäntäperheessä, kouluun liittyvät kustannukset sekä matkavakuutuksen. Vaihdon aikana opiskelijat tutustuvat japanilaisen koulun arkeen ja myös esittelevät Suomea oppitunneilla ja luennoilla. Vaihdon hakuaika on yleensä tammi-helmikuussa, ja siitä ilmoitetaan Wilman kautta. Vaihtoon valitaan ensisijaisesti toisen vuoden opiskelijoita, joiden toivotaan toimivan isäntäperheenä seuraavana syksynä tuleville vaihto-opiskelijoille.</p>`
      },
      {
        type: 'image',
        src: '/images/jiyu-exact-2.jpg',
        caption: 'Isäntäperheiden opiskelijat hyvästelemässä vaihto-opiskelijoita ennen kotimatkaa elokuussa 2023.',
        alt: 'Isäntäperheiden opiskelijat hyvästelemässä vaihto-opiskelijoita'
      },
      {
        type: 'section',
        title: 'Isäntäperheeksi?',
        contentHTML: `<p class="text-slate-700 leading-relaxed">Haluatteko ripauksen kansainvälisyyttä kotiin? Joka toinen vuosi etsimme yhteensä neljää isäntäperhettä Alajärvelle saapuville Jiyu Gakuenin opiskelijoille. Vaihto ajoittuu yleensä elokuun loppuun ja kestää kaksi viikkoa. Seuraavan kerran isäntäperheitä tarvitaan elokuussa 2025. Mikäli olet kiinnostunut, ota yhteyttä Wilmassa Emmi Seppälään.</p>`
      },
      {
        type: 'image',
        src: '/images/jiyu-exact-3.jpg',
        caption: 'Jiyu Gakuenin opiskelijat tutustumassa Alvar Aallon arkkitehtuuriin Alajärvellä elokuussa 2024. Kierroksella olivat mukana kansainvälisyyskerhon opiskelijat.',
        alt: 'Jiyu Gakuenin opiskelijat Alajärvellä elokuussa 2024'
      },
      {
        type: 'section',
        title: 'Alajärven lukion tervehdys Jiyu Gakuenille',
        contentHTML: `<p class="text-slate-700 leading-relaxed">Yhteistyön myötä Alajärven ja Vimpelin lukioissa on aloitettu japanin opetus. Videolla japanin opiskelijat esittelevät lukiota japaniksi. Videotervehdys on tehty Jiyu Gakuenille, joka täytti 100 vuotta vuonna 2021.</p>`
      },
      {
        type: 'video',
        url: 'https://youtu.be/0hdWwFgWyBI?si=0KhzaLItPgUjRUFe',
        caption: 'Alajärven lukion tervehdys 100-vuotiaalle Jiyu Gakuenille (YouTube-video)'
      }
    ]
  },
  'mukawa': {
    title: 'Mukawa -yhteistyö',
    subtitle: 'Mukawan lukio ja yhteistyö Hokkaidolla.',
    lead: 'Mukawan lukio on Alajärven lukion kokoinen koulu Japanin pohjoisella saarella, Hokkaidolla. Koulu sijaitsee maaseudulla ja se on erityisesti tunnettu hyvästä baseball-joukkueestaan.',
    cards: [
      {
        type: 'section',
        title: 'Mukawan lukio',
        contentHTML: `<p class="text-slate-700 leading-relaxed">Mukawan lukio on Alajärven lukion kokoinen koulu Japanin pohjoisella saarella, Hokkaidolla. Koulu sijaitsee maaseudulla ja se on erityisesti tunnettu hyvästä baseball-joukkueestaan.</p>`
      },
      {
        type: 'image',
        src: '/images/mukawa-exact-1.jpg',
        caption: 'Mukawan lukio Hokkaidolla.',
        alt: 'Mukawan lukio'
      },
      {
        type: 'section',
        title: 'Kansainvälisyyskerho',
        contentHTML: `<p class="text-slate-700 leading-relaxed">Kansainvälisyyskerho mahdollistaa kansainvälisen kokemuksen kartuttamisen ja englannin harjoittelun matalalla kynnyksellä. Toteutamme yhteistyössä Mukawan lukion kanssa kansainvälisyyskerhoa, jossa opiskelijat keskustelevat toisilleen englanniksi Discord-sovelluksen kautta. Vapaan keskustelun ohella opiskelijat tekevät pieniä video-, kuva- ja tekstitehtäviä eri aiheista, esimerkiksi juhlapyhistä, kouluruokailusta ja harrastuksista. Samalla tutustumme opiskelijoihin toisella puolella maailmaa ja opimme heidän kulttuuristaan.</p><p class="text-slate-700 leading-relaxed mt-3">Kerhon toimintaan kuuluu snack exchange eli herkkujen vaihto kerran vuodessa, jolloin pääsemme maistelemaan makeisia suoraan Japanista. Kansainvälisyyskerhon jäsenet ovat toimineet myös vaihto-opiskelijoiden tukioppilaina ja olleet mukana ohjelmassa, kun koululla vierailevat esimerkiksi Tokion yhteistyökoulun opiskelijat.</p>`
      },
      {
        type: 'image',
        src: '/images/mukawa-exact-2.jpg',
        caption: 'Mukavasta vieraili kaksi opettajaa ja kaksi opiskelijaa Alajärvellä marraskuussa 2023.',
        alt: 'Mukavan vieraat Alajärvellä'
      },
      {
        type: 'section',
        title: 'Vaihto',
        contentHTML: `<p class="text-slate-700 leading-relaxed">Myös Mukawan kanssa on tehty vaihto-opiskelua molempiin suuntiin Scandinavia-Japan Sasakawa Foundationin avustuksella. Mukawasta vieraili kaksi opettajaa ja kaksi opiskelijaa Alajärvellä marraskuussa 2023. Alajärveltä puolestaan vieraili Mukawassa yksi opettaja ja neljä opiskelijaa kesä-heinäkuussa 2024.</p>`
      },
      {
        type: 'image',
        src: '/images/mukawa-exact-3.jpg',
        caption: 'Alajärveltä vieraili Mukawassa yksi opettaja ja neljä opiskelijaa kesä-heinäkuussa 2024.',
        alt: 'Alajärven opiskelijoita Mukawassa'
      }
    ]
  },
  'muu': {
    title: 'Muu kansainvälinen toiminta',
    subtitle: 'Erasmus+ -hankkeet, kielimatkat ja kansainväliset vierailut.',
    contentHTML: `
      <p class="text-slate-700 leading-relaxed mb-4">
        Japanin-yhteistyön lisäksi Alajärven lukio osallistuu eurooppalaisiin opiskelijahankkeisiin ja kielimatkoihin. Kannustamme opiskelijoitamme avartamaan maailmankuvaansa!
      </p>
    `
  }
};

const details = defaultDetails[slug as string] || {
  title: page?.title || 'Kansainvälisyys',
  subtitle: 'Kansainvälistä toimintaa Alajärven lukiossa.',
  contentHTML: '<p class="text-slate-700">Lisätietoja tulossa pian.</p>'
};

const pageSections = page?.sections && page.sections.length > 0 ? page.sections : (details.sections || []);
const pageGallery = page?.gallery && page.gallery.length > 0 ? page.gallery : (details.gallery || []);
const pageLead = page?.lead || details.lead;

const cardsList = (page?.sections?.length || page?.gallery?.length || bodyCards.length)
  ? [
      ...bodyCards.map(c => ({ type: 'body', data: c })),
      ...pageSections.map(s => ({ type: 'section', data: s })),
      ...pageGallery.map(g => ({ type: 'image', data: g })),
      ...(page?.youtubeUrl ? [{ type: 'video', data: { url: page.youtubeUrl, caption: 'Sivun YouTube-video' } }] : [])
    ]
  : (details.cards || []);

const hasCards = cardsList.length > 0;
---

<Layout title={`${details.title} | Alajärven lukio`}>
  <Header />

  <main id="main-content" tabindex="-1" class="py-12 bg-slate-50 min-h-[70vh] focus:outline-none">
    <div class="max-w-5xl mx-auto px-4 sm:px-8 space-y-6">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-2">
        <a href="/" class="hover:text-alajarvi-600">Etusivu</a>
        <ChevronRight class="w-3.5 h-3.5" />
        <span class="text-alajarvi-600">Kansainvälisyys</span>
        <ChevronRight class="w-3.5 h-3.5" />
        <span class="text-slate-800">{details.title}</span>
      </nav>

      <!-- Page Header Card -->
      <div class="p-6 sm:p-8 md:p-10 rounded-3xl bg-gradient-to-br from-alajarvi-900 via-alajarvi-800 to-alajarvi-700 text-white shadow-xl relative overflow-hidden">
        <div class="relative z-10 space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-md flex items-center justify-center text-amber-300">
            <Globe class="w-6 h-6" />
          </div>
          <h1 class="font-display font-extrabold text-2xl sm:text-4xl text-white">
            {page?.title || details.title}
          </h1>
          <p class="text-sm sm:text-base text-slate-200 max-w-2xl">
            {pageLead || details.subtitle}
          </p>
        </div>
      </div>

      <!-- Jump Navigation for Sections or PortableText Headings -->
      {anchors.length > 0 && (
        <LongPageNav anchors={anchors} title="Sisällysluettelo" />
      )}

      {page?.externalLink && (
        <div class="p-5 sm:p-6 rounded-3xl bg-gradient-to-r from-alajarvi-800 to-alajarvi-900 text-white flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-lg">
          <div class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-wider text-sky-300">Verkkolinkki / Google Drive</span>
            <h4 class="font-bold text-white text-base sm:text-lg">{page.externalLinkTitle || 'Avaa verkkolinkki / dokumentti'}</h4>
          </div>
          <a
            href={page.externalLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-white hover:bg-alajarvi-50 text-alajarvi-900 text-sm font-extrabold transition-all shadow-md active:scale-95 shrink-0"
          >
            <span>{page.externalLinkTitle || 'Avaa linkki'}</span>
            <ExternalLink class="w-4 h-4 text-alajarvi-600" />
          </a>
        </div>
      )}

      {/* Main Banner Image if uploaded in Sanity */}
      {page?.mainImage && (
        <div class="group relative rounded-3xl overflow-hidden shadow-lg border border-slate-200 bg-white hover:shadow-xl transition-all">
          <a href={urlFor(page.mainImage)?.width(1920).quality(95).url()} target="_blank" rel="noopener noreferrer" class="block relative cursor-zoom-in overflow-hidden bg-slate-50 flex flex-col justify-center">
            <img
              src={urlFor(page.mainImage)?.width(1920).quality(95).url()}
              alt={page.mainImage.alt || page.mainImage.caption || page?.title || 'Sivun kuva'}
              loading="eager"
              class="w-full h-auto object-contain rounded-t-3xl group-hover:scale-[1.01] transition-transform duration-300 max-h-[700px]"
            />
            <div class="absolute bottom-4 right-4 px-4 py-2 rounded-xl bg-slate-900/85 text-white text-xs font-semibold backdrop-blur-md opacity-90 group-hover:opacity-100 transition-opacity flex items-center gap-1.5 shadow-md">
              <span>Avaa kuva täysikokoisena / Suurenna 🔍</span>
            </div>
          </a>
          {page.mainImage.caption && (
            <div class="p-4 bg-white border-t border-slate-100 text-sm text-slate-700 font-semibold text-center">
              {page.mainImage.caption}
            </div>
          )}
        </div>
      )}

      <!-- CARDS GRID LAYOUT: Unified side-by-side 2-column sections (Text on Left, Image/Video on Right) -->
      {isCardsLayout ? (
        <div class="space-y-8">
          
          {pageLead && (
            <div class="p-6 sm:p-8 rounded-3xl bg-white shadow-sm border border-alajarvi-100 text-alajarvi-900 font-medium text-base sm:text-lg leading-relaxed">
              {pageLead}
            </div>
          )}

          {/* Unified Paired Sections (Text + Image/Video side-by-side) */}
          {pageSections && pageSections.length > 0 ? (
            <div class="space-y-8">
              {pageSections.map((sec: any, idx: number) => {
                const secId = sec.anchorId || `aihe-${idx + 1}`;
                
                // Find matching image (from section.image or pageGallery[idx] or details.cards)
                const secImage = sec.image || (pageGallery && pageGallery[idx]) || (details.cards && details.cards.filter((c: any) => c.type === 'image')[idx]);
                const imageUrl = secImage?.src || (secImage?.asset ? urlFor(secImage)?.width(1600).quality(95).url() : null);
                const imageCaption = secImage?.caption || secImage?.alt;
                const secVideoUrl = sec.videoUrl || (slug === 'jiyu-gakuen' && idx === pageSections.length - 1 ? 'https://youtu.be/0hdWwFgWyBI' : page?.youtubeUrl);

                return (
                  <section
                    id={secId}
                    class="scroll-mt-28 p-6 sm:p-8 md:p-10 rounded-3xl bg-white shadow-md border border-slate-200/90 hover:border-alajarvi-300 transition-all"
                  >
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
                      
                      <!-- Left Column: Section Title & Text -->
                      <div class="space-y-4 flex flex-col justify-center">
                        <div class="flex items-center gap-3 border-b border-slate-100 pb-3">
                          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-alajarvi-600 to-alajarvi-800 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-sm">
                            {idx + 1}
                          </div>
                          <h2 class="font-display font-bold text-xl sm:text-2xl text-alajarvi-900">
                            {sec.title}
                          </h2>
                        </div>

                        <div class="text-slate-700 leading-relaxed text-base space-y-3">
                          {sec.content ? (
                            <PortableText value={sec.content} />
                          ) : sec.contentHTML ? (
                            <div set:html={sec.contentHTML} />
                          ) : null}
                        </div>
                      </div>

                      <!-- Right Column: Image or Video -->
                      <div class="w-full flex flex-col justify-center">
                        {imageUrl ? (
                          <div class="group relative rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-slate-50">
                            <a href={imageUrl} target="_blank" rel="noopener noreferrer" class="block relative cursor-zoom-in overflow-hidden">
                              <img
                                src={imageUrl}
                                alt={secImage?.alt || imageCaption || sec.title}
                                loading="lazy"
                                class="w-full h-auto max-h-[380px] object-cover rounded-t-2xl group-hover:scale-[1.02] transition-transform duration-300"
                              />
                              <div class="absolute bottom-3 right-3 px-3 py-1.5 rounded-xl bg-slate-900/85 text-white text-xs font-semibold backdrop-blur-md opacity-90 group-hover:opacity-100 transition-opacity flex items-center gap-1.5 shadow-md">
                                <span>Avaa kuva 🔍</span>
                              </div>
                            </a>
                            {imageCaption && (
                              <div class="p-3.5 bg-slate-50 border-t border-slate-100 text-xs text-slate-600 font-medium italic text-center">
                                {imageCaption}
                              </div>
                            )}
                          </div>
                        ) : secVideoUrl ? (
                          <div class="rounded-2xl overflow-hidden shadow-md border border-slate-200">
                            <YouTubeEmbed url={secVideoUrl} caption={sec.title} />
                          </div>
                        ) : null}
                      </div>

                    </div>
                  </section>
                );
              })}
            </div>
          ) : (
            <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200/80 prose prose-slate max-w-none" set:html={details.contentHTML} />
          )}

          <!-- PDF files in cards mode -->
          {page?.pdfFiles && page.pdfFiles.length > 0 && (
            <div class="space-y-4 pt-4">
              <h3 class="font-bold text-slate-900 text-base flex items-center gap-2">
                <FileText class="w-5 h-5 text-alajarvi-600" />
                <span>Ladattavat liitedokumentit & PDF-tiedostot</span>
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {page.pdfFiles.map((file: any) => (
                  file.fileUrl && (
                    <a
                      href={file.fileUrl}
                      target="_blank"
                      download
                      class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-alajarvi-300 shadow-sm hover:shadow-md flex items-center justify-between gap-3 group transition-all"
                    >
                      <div>
                        <h4 class="font-bold text-slate-900 text-sm group-hover:text-alajarvi-600 transition-colors">{file.title || 'Ladattava PDF'}</h4>
                        {file.description && <p class="text-xs text-slate-500 mt-0.5">{file.description}</p>}
                      </div>
                      <FileText class="w-5 h-5 text-alajarvi-500 shrink-0 group-hover:scale-110 transition-transform" />
                    </a>
                  )
                ))}
              </div>
            </div>
          )}

        </div>
      ) : (
        /* STANDARD ARTICLE LAYOUT */
        <div class="bg-white rounded-3xl p-5 sm:p-8 md:p-10 shadow-sm border border-slate-200/80 space-y-8">
          {page?.lead && (
            <div class="p-4 sm:p-5 rounded-2xl bg-alajarvi-50 border border-alajarvi-100 text-alajarvi-900 font-medium text-base leading-relaxed">
              {page.lead}
            </div>
          )}

          {page?.body && page.body.length > 0 ? (
            <PortableText value={page.body} />
          ) : !page?.lead && !page?.pdfFiles?.length && !page?.gallery?.length && !page?.sections?.length ? (
            <div class="prose prose-slate max-w-none" set:html={details.contentHTML} />
          ) : null}

          {page?.sections && page.sections.length > 0 && (
            <div class="space-y-8 pt-4">
              {page.sections.map((sec: any, idx: number) => {
                const secId = sec.anchorId || `aihe-${idx + 1}`;
                return (
                  <section id={secId} class="scroll-mt-28 p-6 sm:p-8 rounded-2xl bg-slate-50/80 border border-slate-200/90 space-y-4">
                    <div class="flex items-center gap-3 border-b border-slate-200 pb-4">
                      <div class="w-9 h-9 rounded-xl bg-alajarvi-600 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-xs">
                        {idx + 1}
                      </div>
                      <h2 class="font-display font-bold text-xl sm:text-2xl text-alajarvi-900">
                        {sec.title}
                      </h2>
                    </div>
                    {sec.content && (
                      <div class="pt-2">
                        <PortableText value={sec.content} />
                      </div>
                    )}
                  </section>
                );
              })}
            </div>
          )}

          {page?.gallery && page.gallery.length > 0 && (
            <div class="mt-8 pt-8 border-t border-slate-200 space-y-6">
              <h3 class="font-bold text-slate-900 text-lg flex items-center gap-2">
                <ImageIcon class="w-5 h-5 text-alajarvi-600" />
                <span>Sivun kuvat & Taulukot ({page.gallery.length})</span>
              </h3>
              <div class="grid grid-cols-1 gap-8">
                {page.gallery.map((img: any) => {
                  const galleryImgUrl = urlFor(img)?.width(1920).quality(95).url();
                  if (!galleryImgUrl) return null;
                  return (
                    <div class="group relative rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-slate-50 flex flex-col">
                      <a href={galleryImgUrl} target="_blank" rel="noopener noreferrer" class="block relative cursor-zoom-in overflow-hidden">
                        <img
                          src={galleryImgUrl}
                          alt={img.alt || img.caption || 'Sivun kuva'}
                          loading="lazy"
                          class="w-full h-auto object-contain rounded-t-2xl group-hover:scale-[1.01] transition-transform duration-300"
                        />
                        <div class="absolute bottom-3 right-3 px-3 py-1.5 rounded-xl bg-slate-900/85 text-white text-xs font-semibold backdrop-blur-md opacity-90 group-hover:opacity-100 transition-opacity flex items-center gap-1.5 shadow-md">
                          <span>Avaa täysikokoisena / Suurenna 🔍</span>
                        </div>
                      </a>
                      {img.caption && (
                        <div class="p-4 bg-white border-t border-slate-100 text-sm text-slate-700 font-semibold text-center">
                          {img.caption}
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {page?.pdfFiles && page.pdfFiles.length > 0 && (
            <div class="mt-8 pt-8 border-t border-slate-200 space-y-4">
              <h3 class="font-bold text-slate-900 text-base flex items-center gap-2">
                <FileText class="w-5 h-5 text-alajarvi-600" />
                <span>Ladattavat liitedokumentit & PDF-tiedostot</span>
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {page.pdfFiles.map((file: any) => (
                  file.fileUrl && (
                    <a
                      href={file.fileUrl}
                      target="_blank"
                      download
                      class="p-4 rounded-2xl bg-slate-50 border border-slate-200 hover:border-alajarvi-300 shadow-xs flex items-center justify-between gap-3 group transition-all"
                    >
                      <div>
                        <h4 class="font-bold text-slate-900 text-sm group-hover:text-alajarvi-600 transition-colors">{file.title || 'Ladattava PDF'}</h4>
                        {file.description && <p class="text-xs text-slate-500">{file.description}</p>}
                      </div>
                      <FileText class="w-5 h-5 text-alajarvi-500 shrink-0 group-hover:scale-110 transition-transform" />
                    </a>
                  )
                ))}
              </div>
            </div>
          )}
        </div>
      )}

    </div>
  </main>

  <Footer />
</Layout>
