---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LongPageNav from '../../components/LongPageNav.astro';
import HeroWave from '../../components/HeroWave.astro';
import PortableText from '../../components/PortableText.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { getPageBySlug, getAllPages, urlFor, responsiveImage, extractPageAnchors, splitBodyIntoCards } from '../../lib/sanity';
import { BookOpen, ChevronRight, FileText, Calendar, ShieldCheck, HeartHandshake, Award, Image as ImageIcon, CheckCircle, Globe, Star } from 'lucide-astro';

export async function getStaticPaths() {
  const defaultSlugs = [
    'opinto-opas',
    'opintotarjotin',
    'tyoaika',
    'opinto-ohjaus',
    'opiskeluhuolto',
    'yo-kirjoitukset',
    'kodin-ja-koulun-yhteistyo',
    'opetussuunnitelma',
    'ruokalista',
  ];
  const pages = await getAllPages();
  const sanitySlugs = pages.map(p => p.slug?.current).filter(Boolean);
  const allSlugs = Array.from(new Set([...defaultSlugs, ...sanitySlugs]));
  return allSlugs.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = await getPageBySlug(slug as string);

const anchors = extractPageAnchors(page);
const isCardsLayout = page?.layoutStyle === 'cards';
const bodyCards = page?.body ? splitBodyIntoCards(page.body) : [];

// Purely visual icon per page type — not editorial content, so kept in code rather than Sanity
const iconMap: Record<string, any> = {
  'opinto-opas': BookOpen,
  'opintotarjotin': FileText,
  'tyoaika': Calendar,
  'opinto-ohjaus': HeartHandshake,
  'opiskeluhuolto': ShieldCheck,
  'yo-kirjoitukset': Award,
  'lomakkeet': FileText,
  'kodin-ja-koulun-yhteistyo': HeartHandshake,
  'opetussuunnitelma': FileText,
  'ruokalista': ImageIcon,
};
const IconComponent = iconMap[slug as string] || BookOpen;
const pageTitle = page?.title || 'Opiskelijalle';
const pageLead = page?.lead || 'Tietoa lukio-opiskelusta Alajärven lukiossa.';
const hasSections = page?.sections && page.sections.length > 0;
const hasGallery = page?.gallery && page.gallery.length > 0;
const hasBodyCards = bodyCards.length > 0;
const heroImg = page?.heroBgImage ? responsiveImage(page.heroBgImage, [640, 960, 1280, 1600, 1920]) : null;
const mainImg = page?.mainImage ? responsiveImage(page.mainImage, [640, 960, 1280, 1600, 1920]) : null;
---

<Layout
  title={`${pageTitle} | Alajärven lukio`}
  description={pageLead}
  image={heroImg?.src || mainImg?.src}
>
  <Header />

  <main class="bg-transparent min-h-[70vh]">

    <!-- Page Hero — full-width, edge-to-edge (no rounded corners), flush against the header,
         with the flowing Aalto wave mask at the bottom. Breadcrumb lives inside it (restyled
         for the dark background) instead of its own row above. -->
    <div class="relative overflow-hidden bg-gradient-to-br from-alajarvi-900 via-alajarvi-800 to-[#045CD2] text-white">
      {page?.heroBgImage && urlFor(page.heroBgImage) && (
        <div class="absolute inset-0 z-0 pointer-events-none">
          <img
            src={heroImg?.src}
            srcset={heroImg?.srcset}
            sizes="100vw"
            width={heroImg?.width}
            height={heroImg?.height}
            alt={page.heroBgImage.alt || page?.title || 'Hero taustakuva'}
            class="w-full h-full object-cover object-center"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/55 to-slate-950/15"></div>
        </div>
      )}
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-8 py-8 sm:py-12 pb-20 sm:pb-28 space-y-3">
        <nav class="flex items-center gap-2 text-xs font-semibold text-slate-300 mb-3">
          <a href="/" class="hover:text-white transition-colors">Etusivu</a>
          <ChevronRight class="w-3.5 h-3.5 text-slate-500" />
          <span class="text-slate-300">Opiskelijalle</span>
          <ChevronRight class="w-3.5 h-3.5 text-slate-500" />
          <span class="text-white">{pageTitle}</span>
        </nav>

        <div class="w-12 h-12 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-md flex items-center justify-center text-sky-300">
          <IconComponent class="w-6 h-6" />
        </div>
        <h1 class="font-display font-extrabold text-2xl sm:text-4xl text-white">
          {pageTitle}
        </h1>
        <p class="text-sm sm:text-base text-slate-200 max-w-2xl">
          {pageLead}
        </p>
      </div>
      <HeroWave />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6 py-8">

      <!-- Jump Navigation for Sections or PortableText Headings -->
      {anchors.length > 0 && (
        <LongPageNav anchors={anchors} title="Sisällysluettelo" />
      )}

      {/* Liitteet ja linkit (esim. Google Drive -linkit tai ladatut PDF:t) */}
      {page?.documentLinks && page.documentLinks.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {page.documentLinks.map((doc: any) => (
            <a
              href={doc.fileUrl || doc.url}
              target="_blank"
              rel="noopener noreferrer"
              download={doc.fileUrl ? true : undefined}
              class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-alajarvi-300 shadow-sm hover:shadow-md flex items-center justify-between gap-3 group transition-all"
            >
              <div>
                <h4 class="font-bold text-slate-900 text-sm group-hover:text-alajarvi-600 transition-colors">{doc.title}</h4>
                {doc.description && <p class="text-xs text-slate-500 mt-0.5">{doc.description}</p>}
              </div>
              <FileText class="w-5 h-5 text-alajarvi-500 shrink-0 group-hover:scale-110 transition-transform" />
            </a>
          ))}
        </div>
      )}

      {/* Main Banner Image if uploaded in Sanity */}
      {page?.mainImage?.asset && (
        <div class="group relative rounded-3xl overflow-hidden shadow-lg border border-slate-200 bg-white hover:shadow-xl transition-all">
          <a href={mainImg?.src} target="_blank" rel="noopener noreferrer" class="block relative cursor-zoom-in overflow-hidden bg-slate-50 flex flex-col justify-center">
            <img
              src={mainImg?.src}
              srcset={mainImg?.srcset}
              sizes="(min-width: 1024px) 1024px, 100vw"
              width={mainImg?.width}
              height={mainImg?.height}
              alt={page.mainImage.alt || page.mainImage.caption || page?.title || 'Sivun kuva'}
              loading="lazy"
              decoding="async"
              class="w-full h-auto object-contain rounded-t-3xl group-hover:scale-[1.01] transition-transform duration-300 max-h-[42vh] lg:max-h-[600px]"
            />
            <div class="absolute bottom-4 right-4 px-4 py-2 rounded-xl bg-slate-900/85 text-white text-xs font-semibold backdrop-blur-md opacity-90 group-hover:opacity-100 transition-opacity flex items-center gap-1.5 shadow-md">
              <span>Avaa kuva täysikokoisena / Suurenna 🔍</span>
            </div>
          </a>
          {page.mainImage.caption && (
            <div class="p-4 bg-white border-t border-slate-100 text-sm text-slate-700 font-semibold text-center">
              {page.mainImage.caption}
            </div>
          )}
        </div>
      )}

      <!-- CARDS GRID LAYOUT (Unified side-by-side 2-column grid for Body Headings, Sections & Gallery Images) -->
      {isCardsLayout ? (
        <div class="space-y-6">
          
          {page?.lead && (
            <div class="p-5 sm:p-6 rounded-3xl bg-white shadow-sm border border-alajarvi-100 text-alajarvi-900 font-medium text-base leading-relaxed">
              {page.lead}
            </div>
          )}

          {/* Tilasto- / Numerokortit (Stats) */}
          {page?.stats && page.stats.length > 0 && (
            <div class="p-6 rounded-3xl bg-white shadow-sm border border-slate-200/90 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 my-6">
              {page.stats.map((st: any) => (
                <div class="p-4 rounded-2xl bg-alajarvi-50/50 border border-alajarvi-100 space-y-1">
                  <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block">{st.label}</span>
                  <span class="text-3xl font-extrabold font-display text-alajarvi-700">{st.number}</span>
                  {st.description && <p class="text-xs text-slate-600 mt-1">{st.description}</p>}
                </div>
              ))}
            </div>
          )}

          {/* Info- / Korostuskortit (Features) */}
          {page?.features && page.features.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 my-6">
              {page.features.map((feat: any) => (
                <div class="p-5 sm:p-6 rounded-3xl bg-white shadow-sm border border-slate-200/90 hover:border-alajarvi-300 transition-all space-y-2">
                  <div class="flex items-center gap-2.5 font-bold text-slate-900 text-base">
                    {feat.icon === 'globe' ? (
                      <Globe class="w-5 h-5 text-amber-500 shrink-0" />
                    ) : feat.icon === 'star' ? (
                      <Star class="w-5 h-5 text-amber-400 shrink-0" />
                    ) : feat.icon === 'book' ? (
                      <BookOpen class="w-5 h-5 text-sky-500 shrink-0" />
                    ) : feat.icon === 'award' ? (
                      <Award class="w-5 h-5 text-emerald-500 shrink-0" />
                    ) : (
                      <CheckCircle class="w-5 h-5 text-alajarvi-500 shrink-0" />
                    )}
                    <span>{feat.title}</span>
                  </div>
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">{feat.description}</p>
                </div>
              ))}
            </div>
          )}

          <!-- Unified 2-column Grid for Body Cards, Sections and Gallery Images -->
          {(hasBodyCards || hasSections || hasGallery) ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 items-stretch">
              
              <!-- 1. PortableText Body Headings split into individual cards -->
              {bodyCards.map((card: any) => (
                <div id={card.anchorId} class="scroll-mt-28 p-6 sm:p-8 rounded-3xl bg-white shadow-md border border-slate-200/90 hover:border-alajarvi-300 transition-all flex flex-col justify-between space-y-3" style="scroll-margin-top: var(--anchor-offset, 112px)">
                  {card.title && (
                    <h2 class="font-display font-bold text-xl sm:text-2xl text-alajarvi-900 border-b border-slate-100 pb-3">
                      {card.title}
                    </h2>
                  )}
                  <div class="text-slate-700 flex-grow pt-1">
                    <PortableText value={card.blocks} />
                  </div>
                </div>
              ))}

              <!-- 2. Sections rendered as cards in the same grid -->
              {page?.sections?.map((sec: any, idx: number) => {
                const secId = sec.anchorId || `aihe-${idx + 1}`;
                const secImage = sec.image;
                const imageUrl = secImage?.asset ? urlFor(secImage)?.width(1600).quality(85).url() : null;
                const secImgResponsive = secImage?.asset ? responsiveImage(secImage, [400, 640, 828, 1080]) : null;
                const imageCaption = secImage?.caption || secImage?.alt;
                const secVideoUrl = sec.videoUrl;
                const hasMedia = imageUrl || secVideoUrl;

                return (
                  <section
                    id={secId}
                    class="scroll-mt-28 p-6 sm:p-8 rounded-3xl bg-white shadow-md border border-slate-200/90 hover:border-alajarvi-300 transition-all space-y-4"
                    style="scroll-margin-top: var(--anchor-offset, 112px)"
                  >
                    <div class={hasMedia ? "grid grid-cols-1 lg:grid-cols-2 gap-8 items-center" : "space-y-4"}>
                      <div class={hasMedia && idx % 2 === 1 ? "lg:order-2 space-y-4" : "space-y-4"}>
                        <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
                          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-alajarvi-600 to-alajarvi-800 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-sm">
                            {idx + 1}
                          </div>
                          <h2 class="font-display font-bold text-xl sm:text-2xl text-alajarvi-900">
                            {sec.title}
                          </h2>
                        </div>
                        {sec.content && (
                          <div class="pt-1 text-slate-700 flex-grow">
                            <PortableText value={sec.content} />
                          </div>
                        )}
                      </div>
                      {imageUrl ? (
                        <div class={`w-full flex flex-col justify-center ${idx % 2 === 1 ? 'lg:order-1' : 'lg:order-2'}`}>
                          <div class="group relative rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-slate-50">
                            <a href={imageUrl} target="_blank" rel="noopener noreferrer" class="block relative cursor-zoom-in overflow-hidden">
                              <img
                                src={secImgResponsive?.src || imageUrl}
                                srcset={secImgResponsive?.srcset}
                                sizes="(min-width: 1024px) 50vw, 100vw"
                                width={secImgResponsive?.width}
                                height={secImgResponsive?.height}
                                alt={secImage?.alt || imageCaption || sec.title}
                                loading="lazy"
                                decoding="async"
                                class="w-full h-auto max-h-[380px] object-cover rounded-t-2xl group-hover:scale-[1.02] transition-transform duration-300"
                              />
                              <div class="absolute bottom-3 right-3 px-3 py-1.5 rounded-xl bg-slate-900/85 text-white text-xs font-semibold backdrop-blur-md opacity-90 group-hover:opacity-100 transition-opacity flex items-center gap-1.5 shadow-md">
                                <span>Avaa kuva 🔍</span>
                              </div>
                            </a>
                            {imageCaption && (
                              <div class="p-3.5 bg-slate-50 border-t border-slate-100 text-xs text-slate-600 font-medium italic text-center">
                                {imageCaption}
                              </div>
                            )}
                          </div>
                        </div>
                      ) : secVideoUrl ? (
                        <div class={`w-full flex flex-col justify-center ${idx % 2 === 1 ? 'lg:order-1' : 'lg:order-2'}`}>
                          <div class="rounded-2xl overflow-hidden shadow-md border border-slate-200">
                            <YouTubeEmbed url={secVideoUrl} caption={sec.title} />
                          </div>
                        </div>
                      ) : null}
                    </div>
                  </section>
                );
              })}

              <!-- 3. Gallery Images rendered as cards in the same grid -->
              {page?.gallery?.map((img: any) => {
                const galleryImgUrl = urlFor(img)?.width(1920).quality(85).url();
                const galleryImg = responsiveImage(img, [400, 640, 828, 1080]);
                if (!galleryImgUrl) return null;
                return (
                  <div class="group relative rounded-3xl overflow-hidden shadow-md border border-slate-200 bg-white flex flex-col justify-between hover:shadow-lg transition-all h-full">
                    <a href={galleryImgUrl} target="_blank" rel="noopener noreferrer" class="block relative cursor-zoom-in overflow-hidden bg-slate-50 h-full flex flex-col justify-center">
                      <img
                        src={galleryImg?.src || galleryImgUrl}
                        srcset={galleryImg?.srcset}
                        sizes="(min-width: 1024px) 50vw, 100vw"
                        width={galleryImg?.width}
                        height={galleryImg?.height}
                        alt={img.alt || img.caption || 'Sivun kuva'}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-auto object-contain rounded-t-3xl group-hover:scale-[1.01] transition-transform duration-300 max-h-[500px]"
                      />
                      <div class="absolute bottom-3 right-3 px-3 py-1.5 rounded-xl bg-slate-900/85 text-white text-xs font-semibold backdrop-blur-md opacity-90 group-hover:opacity-100 transition-opacity flex items-center gap-1.5 shadow-md">
                        <span>Avaa täysikokoisena / Suurenna 🔍</span>
                      </div>
                    </a>
                    {img.caption && (
                      <div class="p-4 bg-white border-t border-slate-100 text-sm text-slate-700 font-semibold text-center">
                        {img.caption}
                      </div>
                    )}
                  </div>
                );
              })}

            </div>
          ) : !page?.lead && !page?.documentLinks?.length ? (
            <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-sm border border-slate-200/80 text-center text-slate-500 text-sm">
              Sisältöä päivitetään pian.
            </div>
          ) : null}

        </div>
      ) : (
        /* STANDARD ARTICLE LAYOUT */
        <div class="bg-white rounded-3xl p-5 sm:p-8 md:p-10 shadow-sm border border-slate-200/80 space-y-8">
          {page?.lead && (
            <div class="p-4 sm:p-5 rounded-2xl bg-alajarvi-50 border border-alajarvi-100 text-alajarvi-900 font-medium text-base leading-relaxed">
              {page.lead}
            </div>
          )}

          {/* Tilasto- / Numerokortit (Stats) */}
          {page?.stats && page.stats.length > 0 && (
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 my-6">
              {page.stats.map((st: any) => (
                <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-1 shadow-xs">
                  <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block">{st.label}</span>
                  <span class="text-3xl font-extrabold font-display text-alajarvi-700">{st.number}</span>
                  {st.description && <p class="text-xs text-slate-600 mt-1">{st.description}</p>}
                </div>
              ))}
            </div>
          )}

          {/* Info- / Korostuskortit (Features) */}
          {page?.features && page.features.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 my-6">
              {page.features.map((feat: any) => (
                <div class="p-5 rounded-2xl bg-alajarvi-50/60 border border-alajarvi-100 space-y-2">
                  <div class="flex items-center gap-2.5 font-bold text-alajarvi-900 text-base">
                    {feat.icon === 'globe' ? (
                      <Globe class="w-5 h-5 text-amber-500 shrink-0" />
                    ) : feat.icon === 'star' ? (
                      <Star class="w-5 h-5 text-amber-400 shrink-0" />
                    ) : feat.icon === 'book' ? (
                      <BookOpen class="w-5 h-5 text-sky-500 shrink-0" />
                    ) : feat.icon === 'award' ? (
                      <Award class="w-5 h-5 text-emerald-500 shrink-0" />
                    ) : (
                      <CheckCircle class="w-5 h-5 text-alajarvi-500 shrink-0" />
                    )}
                    <span>{feat.title}</span>
                  </div>
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">{feat.description}</p>
                </div>
              ))}
            </div>
          )}

          {page?.body && page.body.length > 0 ? (
            <PortableText value={page.body} />
          ) : !page?.lead && !page?.documentLinks?.length && !page?.gallery?.length && !page?.sections?.length ? (
            <p class="text-center text-slate-500 text-sm py-8">Sisältöä päivitetään pian.</p>
          ) : null}

          {page?.sections && page.sections.length > 0 && (
            <div class="space-y-8 pt-4">
              {page.sections.map((sec: any, idx: number) => {
                const secId = sec.anchorId || `aihe-${idx + 1}`;
                const secImage = sec.image;
                const imageUrl = secImage?.asset ? urlFor(secImage)?.width(1600).quality(85).url() : null;
                const secImgResponsive = secImage?.asset ? responsiveImage(secImage, [400, 640, 828, 1080]) : null;
                const imageCaption = secImage?.caption || secImage?.alt;
                const secVideoUrl = sec.videoUrl;
                const hasMedia = imageUrl || secVideoUrl;

                return (
                  <section id={secId} class="scroll-mt-28 p-6 sm:p-8 rounded-2xl bg-slate-50/80 border border-slate-200/90 space-y-4" style="scroll-margin-top: var(--anchor-offset, 112px)">
                    <div class={hasMedia ? "grid grid-cols-1 lg:grid-cols-2 gap-8 items-center" : "space-y-4"}>
                      <div class={hasMedia && idx % 2 === 1 ? "lg:order-2 space-y-4" : "space-y-4"}>
                        <div class="flex items-center gap-3 border-b border-slate-200 pb-4">
                          <div class="w-9 h-9 rounded-xl bg-alajarvi-600 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-xs">
                            {idx + 1}
                          </div>
                          <h2 class="font-display font-bold text-xl sm:text-2xl text-alajarvi-900">
                            {sec.title}
                          </h2>
                        </div>
                        {sec.content && (
                          <div class="pt-2">
                            <PortableText value={sec.content} />
                          </div>
                        )}
                      </div>
                      {imageUrl ? (
                        <div class={`w-full flex flex-col justify-center ${idx % 2 === 1 ? 'lg:order-1' : 'lg:order-2'}`}>
                          <div class="group relative rounded-xl overflow-hidden shadow-sm border border-slate-200 bg-white">
                            <a href={imageUrl} target="_blank" rel="noopener noreferrer" class="block relative cursor-zoom-in overflow-hidden">
                              <img
                                src={secImgResponsive?.src || imageUrl}
                                srcset={secImgResponsive?.srcset}
                                sizes="(min-width: 1024px) 50vw, 100vw"
                                width={secImgResponsive?.width}
                                height={secImgResponsive?.height}
                                alt={secImage?.alt || imageCaption || sec.title}
                                loading="lazy"
                                decoding="async"
                                class="w-full h-auto max-h-[380px] object-cover rounded-t-xl group-hover:scale-[1.02] transition-transform duration-300"
                              />
                              <div class="absolute bottom-3 right-3 px-3 py-1.5 rounded-xl bg-slate-900/85 text-white text-xs font-semibold backdrop-blur-md opacity-90 group-hover:opacity-100 transition-opacity flex items-center gap-1.5 shadow-md">
                                <span>Avaa kuva 🔍</span>
                              </div>
                            </a>
                            {imageCaption && (
                              <div class="p-3 bg-white border-t border-slate-100 text-xs text-slate-600 font-medium italic text-center">
                                {imageCaption}
                              </div>
                            )}
                          </div>
                        </div>
                      ) : secVideoUrl ? (
                        <div class={`w-full flex flex-col justify-center ${idx % 2 === 1 ? 'lg:order-1' : 'lg:order-2'}`}>
                          <div class="rounded-xl overflow-hidden shadow-sm border border-slate-200">
                            <YouTubeEmbed url={secVideoUrl} caption={sec.title} />
                          </div>
                        </div>
                      ) : null}
                    </div>
                  </section>
                );
              })}
            </div>
          )}

          {page?.gallery && page.gallery.length > 0 && (
            <div class="mt-8 pt-8 border-t border-slate-200 space-y-6">
              <h3 class="font-bold text-slate-900 text-lg flex items-center gap-2">
                <ImageIcon class="w-5 h-5 text-alajarvi-600" />
                <span>Sivun kuvat & Taulukot ({page.gallery.length})</span>
              </h3>
              <div class="grid grid-cols-1 gap-8">
                {page.gallery.map((img: any) => {
                  const galleryImgUrl = urlFor(img)?.width(1920).quality(85).url();
                  const galleryImg = responsiveImage(img, [400, 640, 828, 1080, 1600]);
                  if (!galleryImgUrl) return null;
                  return (
                    <div class="group relative rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-slate-50 flex flex-col">
                      <a href={galleryImgUrl} target="_blank" rel="noopener noreferrer" class="block relative cursor-zoom-in overflow-hidden">
                        <img
                          src={galleryImg?.src || galleryImgUrl}
                          srcset={galleryImg?.srcset}
                          sizes="100vw"
                          width={galleryImg?.width}
                          height={galleryImg?.height}
                          alt={img.alt || img.caption || 'Sivun kuva'}
                          loading="lazy"
                          decoding="async"
                          class="w-full h-auto object-contain rounded-t-2xl group-hover:scale-[1.01] transition-transform duration-300"
                        />
                        <div class="absolute bottom-3 right-3 px-3 py-1.5 rounded-xl bg-slate-900/85 text-white text-xs font-semibold backdrop-blur-md opacity-90 group-hover:opacity-100 transition-opacity flex items-center gap-1.5 shadow-md">
                          <span>Avaa täysikokoisena / Suurenna 🔍</span>
                        </div>
                      </a>
                      {img.caption && (
                        <div class="p-4 bg-white border-t border-slate-100 text-sm text-slate-700 font-semibold text-center">
                          {img.caption}
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          )}

        </div>
      )}

    </div>
  </main>

  <Footer />
</Layout>
