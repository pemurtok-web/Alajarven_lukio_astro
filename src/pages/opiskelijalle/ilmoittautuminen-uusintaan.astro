---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ClipboardList, ChevronRight, Send, User } from 'lucide-astro';
import HeroWave from '../../components/HeroWave.astro';

// Netlify Forms needs a static HTML build of this page to detect the form,
// even though the rest of the site runs in SSR mode.
export const prerender = true;

const pageTitle = 'Ilmoittautuminen uusintaan';
const pageLead = 'Täytä lomake, kun ilmoittaudut uusintakokeeseen, rästikokeeseen tai itsenäisen kurssin kokeeseen.';
---

<Layout
  title={`${pageTitle} | Alajärven lukio`}
  description={pageLead}
>
  <Header />

  <main class="bg-transparent min-h-[70vh]">
    <div class="relative overflow-hidden bg-gradient-to-br from-alajarvi-900 via-alajarvi-800 to-[#045CD2] text-white">
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-8 py-8 sm:py-12 pb-20 sm:pb-28 space-y-3">
        <nav class="flex items-center gap-2 text-xs font-semibold text-slate-300 mb-3">
          <a href="/" class="hover:text-white transition-colors">Etusivu</a>
          <ChevronRight class="w-3.5 h-3.5 text-slate-500" />
          <a href="/opiskelijalle/lomakkeet" class="hover:text-white transition-colors">Lomakkeita</a>
          <ChevronRight class="w-3.5 h-3.5 text-slate-500" />
          <span class="text-white">{pageTitle}</span>
        </nav>

        <div class="w-12 h-12 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-md flex items-center justify-center text-sky-300">
          <ClipboardList class="w-6 h-6" />
        </div>
        <h1 class="font-display font-extrabold text-2xl sm:text-4xl text-white">
          {pageTitle}
        </h1>
        <p class="text-sm sm:text-base text-slate-200 max-w-2xl">
          {pageLead}
        </p>
      </div>
      <HeroWave />
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-6 py-8">

      <form
        name="ilmoittautuminen-uusintaan"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/opiskelijalle/ilmoittautuminen-uusintaan/kiitos"
        class="space-y-6"
      >
        <input type="hidden" name="form-name" value="ilmoittautuminen-uusintaan" />
        <p class="hidden">
          <label>Älä täytä tätä kenttää: <input name="bot-field" /></label>
        </p>

        <section class="p-6 sm:p-8 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-5">
          <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
            <div class="w-9 h-9 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center shrink-0">
              <User class="w-5 h-5" />
            </div>
            <h2 class="font-display font-bold text-xl sm:text-2xl text-alajarvi-900">Ilmoittautumisen tiedot</h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Uusintakoepäivä *</label>
              <input type="date" name="uusintakoepaiva" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-alajarvi-500 focus:ring-2 focus:ring-alajarvi-200 outline-none text-sm" />
            </div>

            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Ilmoittautumisen syy *</label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                {[
                  ['Hylätyn uusintaan', 'Hylätyn uusintaan'],
                  ['Hyväksytyn uusintaan', 'Hyväksytyn uusintaan'],
                  ['Rästikoe', 'Rästikoe'],
                  ['Itsenäisen kurssin koe', 'Itsenäisen kurssin koe'],
                ].map(([value, label]) => (
                  <label class="flex items-center gap-2 text-sm font-medium text-slate-700 px-4 py-2.5 rounded-xl border border-slate-200 has-[:checked]:border-alajarvi-500 has-[:checked]:bg-alajarvi-50 cursor-pointer transition-colors">
                    <input type="radio" name="syy" value={value} required class="w-4 h-4 border-slate-300 text-alajarvi-600 focus:ring-alajarvi-400" />
                    {label}
                  </label>
                ))}
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Opiskelijan nimi *</label>
              <input type="text" name="nimi" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-alajarvi-500 focus:ring-2 focus:ring-alajarvi-200 outline-none text-sm" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Perusryhmä *</label>
              <input type="text" name="perusryhma" required placeholder="esim. 1A, 2B, 3C" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-alajarvi-500 focus:ring-2 focus:ring-alajarvi-200 outline-none text-sm" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Oppiaine *</label>
              <input type="text" name="oppiaine" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-alajarvi-500 focus:ring-2 focus:ring-alajarvi-200 outline-none text-sm" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Kurssin nro *</label>
              <input type="text" name="kurssin_nro" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-alajarvi-500 focus:ring-2 focus:ring-alajarvi-200 outline-none text-sm" />
            </div>
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Aineen opettaja *</label>
              <input type="text" name="aineen_opettaja" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-alajarvi-500 focus:ring-2 focus:ring-alajarvi-200 outline-none text-sm" />
            </div>
          </div>

          <p class="text-xs text-slate-500 pt-2 border-t border-slate-100">
            Lomakkeen lähettäminen omilla tiedoillasi toimii allekirjoituksena.
          </p>
        </section>

        <button
          type="submit"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-alajarvi-500 hover:bg-alajarvi-600 text-white font-bold text-sm shadow-md transition-all cursor-pointer"
        >
          <Send class="w-4 h-4" />
          <span>Lähetä ilmoittautuminen</span>
        </button>
      </form>

    </div>
  </main>

  <Footer />
</Layout>
