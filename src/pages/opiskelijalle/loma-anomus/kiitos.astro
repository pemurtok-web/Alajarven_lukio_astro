---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FormThankYou from '../../../components/FormThankYou.astro';

export const prerender = true;
---

<Layout
  title="Kiitos loma-anomuksesta | Alajärven lukio"
  description="Loma-anomuksesi on vastaanotettu."
>
  <Header />
  <FormThankYou
    title="Kiitos anomuksesta!"
    message="Loma-anomuksesi on vastaanotettu. Rehtori käsittelee anomuksen ja päätöksestä ilmoitetaan erikseen."
    backHref="/opiskelijalle/lomakkeet"
    backLabel="Takaisin lomakkeisiin"
  />
  <Footer />
</Layout>
