---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HeroWave from '../../components/HeroWave.astro';
import {
  FileText,
  ChevronRight,
  Send,
  ExternalLink,
  Award,
  ClipboardList,
  Camera,
  CalendarOff,
  FileSignature,
  GraduationCap,
  Info,
} from 'lucide-astro';

const pageTitle = 'Lomakkeita';
const pageLead = 'Osa lomakkeista voi täyttää suoraan verkossa. Muut lomakkeet ovat ladattavia tiedostoja.';

// Sähköiset lomakkeet — voi täyttää ja lähettää suoraan tällä sivustolla.
const sahkoisetLomakkeet = [
  {
    icon: Award,
    title: 'Ylioppilaskirjoituksiin ilmoittautuminen',
    description: 'Ensimmäistä kertaa kirjoittaville sekä uutta kirjoituskertaa varten.',
    href: '/opiskelijalle/yo-ilmoittautuminen',
  },
  {
    icon: ClipboardList,
    title: 'Ilmoittautuminen uusintaan',
    description: 'Uusintakoe, rästikoe tai itsenäisen kurssin koe.',
    href: '/opiskelijalle/ilmoittautuminen-uusintaan',
  },
  {
    icon: CalendarOff,
    title: 'Loma-anomus (yli viikko)',
    description: 'Yli viikon mittainen poissaolo, jonka rehtori päättää.',
    href: '/opiskelijalle/loma-anomus',
  },
  {
    icon: Camera,
    title: 'Valokuvauslupa',
    description: 'Lupa opiskelijan kuvaamiseen ja kuvien julkaisemiseen.',
    href: '/opiskelijalle/valokuvauslupa',
  },
];

// Ladattavat / ulkoiset lomakkeet, joissa on useamman osapuolen allekirjoitus tai jotka
// eivät ole koulun omia lomakkeita — pysyvät toistaiseksi PDF- tai ulkoisina linkkeinä.
const ladattavatLomakkeet = [
  {
    icon: FileSignature,
    title: 'Itsenäisen opiskelun sopimus',
    description: 'Opettajan, opiskelijan ja rehtorin yhdessä hyväksymä sopimus kurssin suorittamisesta.',
    href: 'https://drive.google.com/file/d/10hAclwe8qHwXXK6XixqxQAXu5vA4CMuL/view?usp=sharing',
  },
  {
    icon: FileText,
    title: 'Opintotukihakemus (Kela)',
    description: 'Kelan oma virallinen lomake opintotuen hakemiseen.',
    href: 'https://www.kela.fi/documents/10192/3861304/OT1.pdf',
  },
  {
    icon: FileText,
    title: 'Todistus opiskelijakortin saamiseksi',
    description: 'Valmis todistuspohja opiskelijakorttia varten.',
    href: 'https://assets.ctfassets.net/lt6mvg8ztynj/2gu1I8vIrZbm9ZgNyligy0/9a42facab6541ad26f95bb95aaa532f3/todistus_opiskelijakortin_saamiseksi_fi_2016.pdf',
  },
  {
    icon: FileText,
    title: 'Hakijan valintakortti',
    description: 'Lomake lukioon hakevalle.',
    href: 'https://drive.google.com/file/d/1olIzKbCJ9BlvJHqQO6oL19DNsN_4h0yK/view?usp=sharing',
  },
  {
    icon: FileText,
    title: 'Valintakortti',
    description: 'Ylioppilaskirjoitusten valvontaan liittyvä lomake.',
    href: 'https://drive.google.com/file/d/1dofiQ5Ydbun13o9Um7WQ3nxa_df-IEQe/view?usp=sharing',
  },
];
---

<Layout
  title={`${pageTitle} | Alajärven lukio`}
  description={pageLead}
>
  <Header />

  <main class="bg-transparent min-h-[70vh]">

    <!-- Page Hero -->
    <div class="relative overflow-hidden bg-gradient-to-br from-alajarvi-900 via-alajarvi-800 to-[#045CD2] text-white">
      <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-8 py-8 sm:py-12 pb-20 sm:pb-28 space-y-3">
        <nav class="flex items-center gap-2 text-xs font-semibold text-slate-300 mb-3">
          <a href="/" class="hover:text-white transition-colors">Etusivu</a>
          <ChevronRight class="w-3.5 h-3.5 text-slate-500" />
          <span class="text-slate-300">Opiskelijalle</span>
          <ChevronRight class="w-3.5 h-3.5 text-slate-500" />
          <span class="text-white">{pageTitle}</span>
        </nav>

        <div class="w-12 h-12 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-md flex items-center justify-center text-sky-300">
          <FileText class="w-6 h-6" />
        </div>
        <h1 class="font-display font-extrabold text-2xl sm:text-4xl text-white">
          {pageTitle}
        </h1>
        <p class="text-sm sm:text-base text-slate-200 max-w-2xl">
          {pageLead}
        </p>
      </div>
      <HeroWave />
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-8 space-y-10 py-8">

      <!-- Poissaolo-info: ohjaa Wilmaan lyhyissä poissaoloissa -->
      <div class="p-5 sm:p-6 rounded-3xl bg-white shadow-sm border border-sky-200 flex items-start gap-3">
        <Info class="w-5 h-5 text-sky-600 shrink-0 mt-0.5" />
        <p class="text-sm text-slate-700">
          <strong class="text-slate-900">Yksittäisten tuntien poissaolo</strong> ilmoitetaan suoraan kyseisen oppitunnin opettajalle, ja
          <strong class="text-slate-900">1–7 päivän poissaolo</strong> ryhmänohjaajalle <a href="https://alajarvi.inschool.fi" target="_blank" rel="noopener noreferrer" class="font-bold text-alajarvi-700 underline hover:text-alajarvi-900">Wilman</a> kautta —
          ei tällä sivustolla. Alla oleva loma-anomus on tarkoitettu vain yli viikon poissaoloihin.
        </p>
      </div>

      <!-- SÄHKÖISET LOMAKKEET -->
      <section class="space-y-5">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
            <Send class="w-5 h-5" />
          </div>
          <div>
            <h2 class="font-display font-bold text-xl sm:text-2xl text-alajarvi-900">Täytä verkossa</h2>
            <p class="text-xs sm:text-sm text-slate-500">Nämä lomakkeet voi täyttää ja lähettää suoraan tällä sivustolla.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
          {sahkoisetLomakkeet.map((lomake) => (
            <a
              href={lomake.href}
              class="group p-5 sm:p-6 rounded-3xl bg-white border border-slate-200/90 shadow-sm hover:shadow-lg hover:border-emerald-300 transition-all flex flex-col gap-3"
            >
              <div class="flex items-start justify-between gap-3">
                <div class="w-11 h-11 rounded-2xl bg-alajarvi-50 text-alajarvi-600 flex items-center justify-center shrink-0 group-hover:bg-alajarvi-500 group-hover:text-white transition-colors">
                  <lomake.icon class="w-5 h-5" />
                </div>
                <span class="shrink-0 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-[10px] font-bold uppercase tracking-wider">
                  Sähköinen lomake
                </span>
              </div>
              <div class="space-y-1 flex-grow">
                <h3 class="font-bold text-slate-900 text-base group-hover:text-alajarvi-700 transition-colors">{lomake.title}</h3>
                <p class="text-xs sm:text-sm text-slate-500">{lomake.description}</p>
              </div>
              <span class="inline-flex items-center gap-1.5 text-sm font-bold text-alajarvi-600 group-hover:gap-2.5 transition-all">
                Täytä lomake
                <ChevronRight class="w-4 h-4" />
              </span>
            </a>
          ))}
        </div>
      </section>

      <!-- LADATTAVAT / ULKOISET LOMAKKEET -->
      <section class="space-y-5">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-slate-200 text-slate-600 flex items-center justify-center shrink-0">
            <FileText class="w-5 h-5" />
          </div>
          <div>
            <h2 class="font-display font-bold text-xl sm:text-2xl text-alajarvi-900">Ladattavat ja ulkoiset lomakkeet</h2>
            <p class="text-xs sm:text-sm text-slate-500">Nämä lomakkeet tulostetaan tai vaativat useamman osapuolen allekirjoituksen.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {ladattavatLomakkeet.map((lomake) => (
            <a
              href={lomake.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group p-5 rounded-2xl bg-white border border-slate-200 hover:border-alajarvi-300 shadow-sm hover:shadow-md flex items-center justify-between gap-3 transition-all"
            >
              <div class="flex items-center gap-3.5 min-w-0">
                <div class="w-10 h-10 rounded-xl bg-slate-50 text-slate-500 flex items-center justify-center shrink-0 group-hover:bg-alajarvi-50 group-hover:text-alajarvi-600 transition-colors">
                  <lomake.icon class="w-5 h-5" />
                </div>
                <div class="min-w-0">
                  <h4 class="font-bold text-slate-900 text-sm group-hover:text-alajarvi-600 transition-colors truncate">{lomake.title}</h4>
                  <p class="text-xs text-slate-500 mt-0.5">{lomake.description}</p>
                </div>
              </div>
              <ExternalLink class="w-4 h-4 text-slate-400 shrink-0 group-hover:text-alajarvi-500 group-hover:scale-110 transition-all" />
            </a>
          ))}
        </div>
      </section>

      <!-- WILMA -->
      <section class="p-5 sm:p-6 rounded-3xl bg-gradient-to-r from-alajarvi-800 to-alajarvi-900 text-white flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-lg">
        <div class="flex items-center gap-3.5">
          <div class="w-11 h-11 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center shrink-0">
            <GraduationCap class="w-5 h-5" />
          </div>
          <div class="space-y-0.5">
            <span class="text-xs font-bold uppercase tracking-wider text-sky-300">Poissaolot & viestintä</span>
            <h4 class="font-bold text-white text-base sm:text-lg">Lyhyet poissaolot ilmoitetaan Wilmassa</h4>
          </div>
        </div>
        <a
          href="https://alajarvi.inschool.fi"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-white hover:bg-alajarvi-50 text-alajarvi-900 text-sm font-extrabold transition-all shadow-md active:scale-95 shrink-0"
        >
          <span>Avaa Wilma</span>
          <ExternalLink class="w-4 h-4 text-alajarvi-600" />
        </a>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
