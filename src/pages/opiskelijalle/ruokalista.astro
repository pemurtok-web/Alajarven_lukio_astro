---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HeroWave from '../../components/HeroWave.astro';
import { ChevronRight, Utensils } from 'lucide-astro';
import menu from '../../data/ruokalista-koulukeskus.json';

const pageTitle = 'Ruokalista';
const pageLead = `${menu.title} ${menu.period}. Lista kiertää viiden viikon jaksoissa.`;
---

<Layout title={`${pageTitle} | Alajärven lukio`} description={pageLead}>
  <Header />

  <main class="bg-transparent min-h-[70vh]">
    <div class="relative overflow-hidden bg-gradient-to-br from-alajarvi-900 via-alajarvi-800 to-[#045CD2] text-white">
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-8 py-8 sm:py-12 pb-20 sm:pb-28 space-y-3">
        <nav class="flex items-center gap-2 text-xs font-semibold text-slate-300 mb-3">
          <a href="/" class="hover:text-white transition-colors">Etusivu</a>
          <ChevronRight class="w-3.5 h-3.5 text-slate-500" />
          <span class="text-slate-300">Opiskelijalle</span>
          <ChevronRight class="w-3.5 h-3.5 text-slate-500" />
          <span class="text-white">{pageTitle}</span>
        </nav>
        <div class="w-12 h-12 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-md flex items-center justify-center text-sky-300">
          <Utensils class="w-6 h-6" />
        </div>
        <h1 class="font-display font-extrabold text-2xl sm:text-4xl text-white">{pageTitle}</h1>
        <p class="text-sm sm:text-base text-slate-200 max-w-2xl">{pageLead}</p>
      </div>
      <HeroWave />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-8 space-y-6">
      <p id="current-week-note" class="hidden text-sm font-semibold text-alajarvi-700"></p>

      <div id="weeks" class="space-y-6">
        {menu.weeks.map((week, i) => (
          <section
            class="week rounded-2xl bg-white border border-slate-200 shadow-sm p-5"
            data-vko={week.vko.join(',')}
            data-order={i}
          >
            <h2 class="font-display font-bold text-lg text-slate-900 mb-1">
              Jakso {i + 1}
              <span class="badge hidden ml-2 align-middle text-xs font-bold bg-alajarvi-600 text-white rounded-full px-2.5 py-0.5">Tämä viikko</span>
            </h2>
            <p class="text-xs text-slate-500 mb-4">Viikot {week.vko.join(', ')}</p>
            <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
              {week.days.map((d) => (
                <div class="rounded-xl bg-slate-50 border border-slate-100 p-3">
                  <h3 class="font-bold text-sm text-alajarvi-700 mb-1.5">{d.day}</h3>
                  <ul class="text-sm text-slate-700 space-y-0.5">
                    {d.items.map((it) => <li>{it}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <p class="text-xs text-slate-500">{menu.note}</p>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  // ISO-viikon numero Suomen ajassa → nostetaan kyseinen jakso ensimmäiseksi
  (function () {
    var now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Helsinki' }));
    var d = new Date(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()));
    d.setUTCDate(d.getUTCDate() + 4 - (d.getUTCDay() || 7));
    var week = Math.ceil(((d - new Date(Date.UTC(d.getUTCFullYear(), 0, 1))) / 864e5 + 1) / 7);
    var container = document.getElementById('weeks');
    var match = Array.prototype.find.call(container.children, function (el) {
      return el.dataset.vko.split(',').indexOf(String(week)) !== -1;
    });
    if (!match) return;
    match.classList.add('ring-2', 'ring-alajarvi-500');
    match.querySelector('.badge').classList.remove('hidden');
    container.prepend(match);
    var note = document.getElementById('current-week-note');
    note.textContent = 'Nyt on viikko ' + week + '.';
    note.classList.remove('hidden');
  })();
</script>
