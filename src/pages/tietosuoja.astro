---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PortableText from '../components/PortableText.astro';
import { getPageBySlug } from '../lib/sanity';
import { ChevronRight, AlertTriangle } from 'lucide-astro';

const page = await getPageBySlug('tietosuoja');
---

<Layout
  title={`${page?.title || 'Tietosuoja ja evästeet'} | Alajärven lukio`}
  description={page?.lead || 'Alajärven lukion tietosuojaseloste ja evästekäytännöt.'}
>
  <Header />

  <main id="main-content" tabindex="-1" class="py-12 bg-transparent min-h-[70vh] focus:outline-none">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-6">

      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-2">
        <a href="/" class="hover:text-alajarvi-600">Etusivu</a>
        <ChevronRight class="w-3.5 h-3.5" />
        <span class="text-slate-800">{page?.title || 'Tietosuoja ja evästeet'}</span>
      </nav>

      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 sm:p-5 flex items-start gap-3">
        <AlertTriangle class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" />
        <p class="text-sm text-amber-900 leading-relaxed">
          <strong>Tämä sivu on luonnos.</strong> Kohdat merkinnällä <code class="px-1 py-0.5 bg-amber-100 rounded text-xs">[TÄYDENNÄ]</code> pitää täyttää oikealla, ajantasaisella tiedolla Sanityssä ennen kuin sivusto julkaistaan. Suosittelemme myös, että Alajärven kaupungin tietosuojavastaava tarkistaa sisällön.
        </p>
      </div>

      <div class="bg-white rounded-3xl p-5 sm:p-8 md:p-10 shadow-sm border border-slate-200/80 space-y-8">
        <h1 class="font-display font-extrabold text-2xl sm:text-3xl text-alajarvi-900">
          {page?.title || 'Tietosuoja ja evästeet'}
        </h1>

        {page?.lead && (
          <div class="p-4 sm:p-5 rounded-2xl bg-alajarvi-50 border border-alajarvi-100 text-alajarvi-900 font-medium text-base leading-relaxed">
            {page.lead}
          </div>
        )}

        {page?.body && page.body.length > 0 && (
          <PortableText value={page.body} />
        )}
      </div>

    </div>
  </main>

  <Footer />
</Layout>
