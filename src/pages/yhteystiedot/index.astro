---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LongPageNav from '../../components/LongPageNav.astro';
import HeroWave from '../../components/HeroWave.astro';
import PortableText from '../../components/PortableText.astro';
import { getPageBySlug, getContactInfo, urlFor, responsiveImage, retinaSrcSet } from '../../lib/sanity';
import { MapPin, Phone, Mail, User, Clock, Send, Trophy, GraduationCap, HeartHandshake, ShieldCheck, FileText } from 'lucide-astro';

const page = await getPageBySlug('yhteystiedot');
const contact = await getContactInfo();
const heroImg = page?.heroBgImage ? responsiveImage(page.heroBgImage, [640, 960, 1280, 1600, 1920]) : null;
const mainImg = page?.mainImage ? responsiveImage(page.mainImage, [640, 960, 1280, 1600, 1920]) : null;

const anchors = [
  { id: 'rehtori-ja-toimisto', label: '1. Rehtorit & Koulusihteeri' },
  { id: 'opinto-ohjaus', label: '2. OPO & Opiskeluhuolto' },
  { id: 'opettajat', label: '3. Opettajakunta' },
  { id: 'valmentajat', label: '4. Liikuntalinjan valmentajat' },
  { id: 'sijainti-ja-kartta', label: '5. Sijainti & Kartta' },
  { id: 'yhteydenotto', label: '6. Yhteydenottolomake' },
];

const leadership = contact.leadership || [];
const studentSupport = contact.studentSupport || [];
const teachers = contact.teachers || [];
const coaches = contact.coaches || [];

const avatarColors = ['bg-alajarvi-600', 'bg-alajarvi-700', 'bg-alajarvi-800'];
const supportIcons: Record<string, typeof GraduationCap> = {
  graduationCap: GraduationCap,
  heartHandshake: HeartHandshake,
  shieldCheck: ShieldCheck,
};

function initials(name?: string) {
  if (!name) return '';
  return name
    .split(' ')
    .filter(Boolean)
    .map((part) => part[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
}
---

<Layout
  title={`${page?.title || 'Yhteystiedot'} | Alajärven lukio`}
  description={page?.lead || 'Alajärven lukion yhteystiedot: johto, opinto-ohjaus, opettajakunta ja sijainti.'}
  image={heroImg?.src || mainImg?.src}
>
  <Header />

  <main class="bg-transparent">

    <!-- Page Hero — full-width, edge-to-edge (no rounded corners), flush against the
         header, with the flowing Aalto wave mask at the bottom. -->
    <div class="relative overflow-hidden bg-gradient-to-br from-alajarvi-900 via-alajarvi-800 to-[#045CD2] text-white">
      {page?.heroBgImage && urlFor(page.heroBgImage) && (
        <div class="absolute inset-0 z-0 pointer-events-none">
          <img
            src={heroImg?.src}
            srcset={heroImg?.srcset}
            sizes="100vw"
            width={heroImg?.width}
            height={heroImg?.height}
            alt={page.heroBgImage.alt || page?.title || 'Hero taustakuva'}
            class="w-full h-full object-cover object-center"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/55 to-slate-950/15"></div>
        </div>
      )}
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-8 py-10 sm:py-14 pb-20 sm:pb-28">
        <div class="space-y-4 max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 text-xs font-semibold text-sky-200 border border-white/20">
            <Phone class="w-4 h-4 text-emerald-300" />
            <span>Olemme täällä sinua varten</span>
          </div>
          <h1 class="font-display font-extrabold text-4xl sm:text-5xl text-white tracking-tight">
            {page?.title || 'Yhteystiedot ja henkilökunta'}
          </h1>
          <p class="text-lg text-slate-200 leading-relaxed font-normal">
            {page?.lead || 'Löydä Alajärven lukion johdon, opinto-ohjaajan, opettajien, opiskeluhuollon sekä valmentajien ajantasaiset yhteystiedot.'}
          </p>
        </div>
      </div>
      <HeroWave />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-8">

      {/* Main Banner Image if uploaded in Sanity */}
      {page?.mainImage && urlFor(page.mainImage) && (
        <div class="overflow-hidden rounded-3xl bg-white border border-slate-200/80 shadow-xl group mb-8">
          <div class="relative overflow-hidden">
            <img
              src={mainImg?.src}
              srcset={mainImg?.srcset}
              sizes="(min-width: 1024px) 1024px, 100vw"
              width={mainImg?.width}
              height={mainImg?.height}
              alt={page.mainImage.alt || page?.title || 'Yhteystiedot kuva'}
              class="w-full h-auto object-cover max-h-[42vh] lg:max-h-[520px]"
              loading="lazy"
              decoding="async"
            />
            {page.mainImage.caption && (
              <div class="p-4 bg-slate-900/90 text-white text-xs sm:text-sm backdrop-blur-md border-t border-white/10">
                {page.mainImage.caption}
              </div>
            )}
          </div>
        </div>
      )}

      {/* Liitteet ja linkit (esim. Google Drive -linkit tai ladatut PDF:t) */}
      {page?.documentLinks && page.documentLinks.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
          {page.documentLinks.map((doc: any) => (
            <a
              href={doc.fileUrl || doc.url}
              target="_blank"
              rel="noopener noreferrer"
              download={doc.fileUrl ? true : undefined}
              class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-alajarvi-300 shadow-sm hover:shadow-md flex items-center justify-between gap-3 group transition-all"
            >
              <div>
                <h4 class="font-bold text-slate-900 text-sm group-hover:text-alajarvi-600 transition-colors">{doc.title}</h4>
                {doc.description && <p class="text-xs text-slate-500 mt-0.5">{doc.description}</p>}
              </div>
              <FileText class="w-5 h-5 text-alajarvi-500 shrink-0 group-hover:scale-110 transition-transform" />
            </a>
          ))}
        </div>
      )}

      {page?.body && (
        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-sm border border-slate-200/80 mb-12">
          <PortableText value={page.body} />
        </div>
      )}

      <!-- Sticky Anchor Links Bar -->
      <LongPageNav anchors={anchors} title="Yhteystiedot - Osioselain" />

      <!-- Long Page Sections -->
      <div class="space-y-12">
        
        <!-- Section 1: Rehtorit & Koulusihteeri -->
        <section id="rehtori-ja-toimisto" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6" style="scroll-margin-top: var(--anchor-offset, 112px)">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
              1
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
              Rehtorit & Koulusihteeri
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {leadership.map((person, i) => (
              <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
                <div class="flex items-center gap-3">
                  {person.image && urlFor(person.image) ? (
                    <img
                      src={urlFor(person.image)?.width(128).height(128).fit('crop').url()}
                      srcset={retinaSrcSet(person.image, 64, 64)}
                      width={64}
                      height={64}
                      alt={person.name || ''}
                      class="w-16 h-16 rounded-full object-cover shrink-0"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class={`w-16 h-16 rounded-full ${avatarColors[i % avatarColors.length]} text-white flex items-center justify-center font-bold text-lg shrink-0`}>
                      {initials(person.name)}
                    </div>
                  )}
                  <div>
                    <h3 class="font-bold text-lg text-slate-900">{person.name}</h3>
                    <span class="text-xs text-alajarvi-600 font-semibold uppercase tracking-wider">{person.role}</span>
                  </div>
                </div>
                <div class="space-y-1.5 text-sm text-slate-600 pt-2 border-t border-slate-200/60">
                  {person.phone && (
                    <p class="flex items-center gap-2">
                      <Phone class="w-4 h-4 text-alajarvi-500 shrink-0" />
                      <a href={`tel:${person.phone.replace(/\s/g, '')}`} class="hover:text-alajarvi-600 font-medium">{person.phone}</a>
                    </p>
                  )}
                  {person.email && (
                    <p class="flex items-center gap-2">
                      <Mail class="w-4 h-4 text-alajarvi-500 shrink-0" />
                      <a href={`mailto:${person.email}`} class="hover:text-alajarvi-600 text-xs">{person.email}</a>
                    </p>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 2: OPO & Opiskeluhuolto -->
        <section id="opinto-ohjaus" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6" style="scroll-margin-top: var(--anchor-offset, 112px)">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
              2
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
              Opinto-ohjaus & Opiskeluhuolto
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {studentSupport.map((person, i) => {
              const Icon = supportIcons[person.icon || 'graduationCap'] || GraduationCap;
              return (
                <div class="p-6 rounded-2xl bg-alajarvi-50/70 border border-alajarvi-100 space-y-3">
                  <div class="flex items-center gap-3">
                    {person.image && urlFor(person.image) ? (
                      <img
                        src={urlFor(person.image)?.width(96).height(96).fit('crop').url()}
                        srcset={retinaSrcSet(person.image, 48, 48)}
                        width={48}
                        height={48}
                        alt={person.name || ''}
                        class="w-12 h-12 rounded-full object-cover shrink-0"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class={`w-12 h-12 rounded-full ${avatarColors[i % avatarColors.length]} text-white flex items-center justify-center font-bold text-lg shrink-0`}>
                        {initials(person.name)}
                      </div>
                    )}
                    <div>
                      <h3 class="font-bold text-lg text-slate-900">{person.name}</h3>
                      <div class="flex items-center gap-1.5 text-alajarvi-700 font-bold text-xs uppercase tracking-wider">
                        <Icon class="w-3.5 h-3.5 text-alajarvi-500" />
                        <span>{person.role}</span>
                      </div>
                    </div>
                  </div>
                  <div class="space-y-1 text-sm text-slate-700 pt-2 border-t border-alajarvi-200">
                    {person.phone && (
                      <p class="flex items-center gap-2">
                        <Phone class="w-4 h-4 text-alajarvi-500 shrink-0" />
                        <a href={`tel:${person.phone.replace(/\s/g, '')}`} class="hover:text-alajarvi-600 font-medium">{person.phone}</a>
                      </p>
                    )}
                    {person.email && (
                      <p class="flex items-center gap-2">
                        <Mail class="w-4 h-4 text-alajarvi-500 shrink-0" />
                        <a href={`mailto:${person.email}`} class="hover:text-alajarvi-600 text-xs">{person.email}</a>
                      </p>
                    )}
                  </div>
                </div>
              );
            })}
          </div>

          {contact.teacherOfficePhone && (
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 flex items-center justify-between text-sm">
              <span class="font-bold text-slate-800">Lukion opettajainhuone:</span>
              <a href={`tel:${contact.teacherOfficePhone.replace(/\s/g, '')}`} class="font-semibold text-alajarvi-600 hover:underline">{contact.teacherOfficePhone}</a>
            </div>
          )}
        </section>

        <!-- Section 3: Opettajakunta -->
        <section id="opettajat" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6" style="scroll-margin-top: var(--anchor-offset, 112px)">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
              3
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
              Opettajakunta
            </h2>
          </div>

          <p class="text-sm text-slate-600 leading-relaxed">
            Opettajien sähköpostiosoitteet ovat muodossa <code class="bg-slate-100 px-2 py-0.5 rounded text-alajarvi-700 text-xs font-mono">{contact.teacherEmailFormat || 'etunimi.sukunimi@alajarvi.fi'}</code>.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {teachers.map(person => (
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1 hover:border-alajarvi-300 transition-colors">
                <h4 class="font-bold text-slate-900 text-sm">{person.name}</h4>
                <p class="text-xs text-alajarvi-600 font-medium">{person.subjects}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 4: Liikuntalinjan valmentajat -->
        <section id="valmentajat" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6" style="scroll-margin-top: var(--anchor-offset, 112px)">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
              4
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
              Liikuntalinjan valmentajat
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {coaches.map(coach => (
              <div class="p-4 rounded-2xl bg-amber-50/60 border border-amber-200/80 space-y-2">
                <div class="flex items-center gap-2 text-amber-700">
                  <Trophy class="w-4 h-4" />
                  <span class="text-xs font-bold uppercase tracking-wider">{coach.sport}</span>
                </div>
                <h4 class="font-bold text-slate-900 text-base">{coach.name}</h4>
                <p class="text-xs text-slate-600">{coach.club}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 5: Sijainti & Kartta -->
        <section id="sijainti-ja-kartta" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6" style="scroll-margin-top: var(--anchor-offset, 112px)">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
              5
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
              Sijainti ja osoite
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            <div class="space-y-4 text-slate-700">
              <div class="flex items-start gap-3">
                <MapPin class="w-5 h-5 text-alajarvi-500 shrink-0 mt-1" />
                <div>
                  <h4 class="font-bold text-slate-900">Käyntiosoite</h4>
                  <p class="text-sm text-slate-600">{contact.schoolName}<br />{contact.visitingAddress}</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <Phone class="w-5 h-5 text-alajarvi-500 shrink-0 mt-1" />
                <div>
                  <h4 class="font-bold text-slate-900">Kanslian puhelinvaihde</h4>
                  <p class="text-sm text-slate-600">{contact.officePhone} ({contact.officeHours})</p>
                </div>
              </div>
            </div>

            <!-- Stylized Map Container -->
            <div class="h-64 rounded-2xl bg-gradient-to-br from-alajarvi-800 to-slate-900 text-white p-6 flex flex-col justify-between shadow-inner relative overflow-hidden">
              <div>
                <span class="text-xs font-bold text-sky-300 uppercase tracking-widest block mb-1">Karttasijainti</span>
                <h4 class="font-display font-bold text-xl text-white">{contact.schoolName}</h4>
                <p class="text-xs text-slate-300">{contact.visitingAddress}</p>
              </div>

              <a
                href={contact.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/20 hover:bg-white text-white hover:text-alajarvi-900 backdrop-blur-md text-xs font-bold transition-all self-start"
              >
                <span>Avaa Google Mapsissa</span>
                <MapPin class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        </section>

        <!-- Section 6: Yhteydenottolomake -->
        <section id="yhteydenotto" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6" style="scroll-margin-top: var(--anchor-offset, 112px)">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
              6
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
              Lähetä viesti lukiolle
            </h2>
          </div>

          <form
            id="yhteydenotto-form"
            name="yhteydenotto"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="space-y-4 max-w-2xl"
          >
            <input type="hidden" name="form-name" value="yhteydenotto" />
            <p class="hidden">
              <label>Älä täytä tätä kenttää: <input name="bot-field" /></label>
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nimesi *</label>
                <input type="text" name="nimi" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-alajarvi-500 focus:ring-2 focus:ring-alajarvi-200 outline-none text-sm" placeholder="Matti Meikäläinen" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Sähköpostiosoite *</label>
                <input type="email" name="sahkoposti" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-alajarvi-500 focus:ring-2 focus:ring-alajarvi-200 outline-none text-sm" placeholder="matti@esimerkki.fi" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Aihe</label>
              <input type="text" name="aihe" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-alajarvi-500 focus:ring-2 focus:ring-alajarvi-200 outline-none text-sm" placeholder="Kysymys lukio-opinnoista" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Viestisi *</label>
              <textarea name="viesti" rows="4" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-alajarvi-500 focus:ring-2 focus:ring-alajarvi-200 outline-none text-sm" placeholder="Kirjoita viestisi tähän..."></textarea>
            </div>

            <button
              type="submit"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-alajarvi-500 hover:bg-alajarvi-600 text-white font-bold text-sm shadow-md transition-all cursor-pointer"
            >
              <Send class="w-4 h-4" />
              <span>Lähetä viesti</span>
            </button>

            <p id="yhteydenotto-error" hidden class="text-sm font-semibold text-red-600">
              Viestin lähetys epäonnistui. Yritä hetken kuluttua uudelleen tai ota yhteyttä puhelimitse.
            </p>
          </form>

          <div id="yhteydenotto-success" hidden class="max-w-2xl p-6 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 font-semibold text-sm">
            Kiitos yhteydenotostasi! Viestisi on vastaanotettu.
          </div>

          <script>
            const form = document.getElementById('yhteydenotto-form') as HTMLFormElement | null;
            const errorEl = document.getElementById('yhteydenotto-error');
            const successEl = document.getElementById('yhteydenotto-success');

            form?.addEventListener('submit', async (event) => {
              event.preventDefault();
              errorEl?.setAttribute('hidden', '');

              try {
                const body = new URLSearchParams(new FormData(form) as any).toString();
                const response = await fetch('/', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                  body,
                });
                if (!response.ok) throw new Error(`Netlify Forms vastasi statuksella ${response.status}`);

                form.hidden = true;
                successEl?.removeAttribute('hidden');
              } catch (err) {
                console.error('Yhteydenottolomakkeen lähetys epäonnistui:', err);
                errorEl?.removeAttribute('hidden');
              }
            });
          </script>
        </section>

      </div>

    </div>
  </main>

  <Footer />
</Layout>
