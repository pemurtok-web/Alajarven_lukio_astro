---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LongPageNav from '../../components/LongPageNav.astro';
import PortableText from '../../components/PortableText.astro';
import { getPageBySlug } from '../../lib/sanity';
import { MapPin, Phone, Mail, User, Clock, Send, Trophy, GraduationCap, HeartHandshake, ShieldCheck } from 'lucide-astro';

export const prerender = false;

const page = await getPageBySlug('yhteystiedot');

const anchors = [
  { id: 'rehtori-ja-toimisto', label: '1. Rehtorit & Koulusihteeri' },
  { id: 'opinto-ohjaus', label: '2. OPO & Opiskeluhuolto' },
  { id: 'opettajat', label: '3. Opettajakunta' },
  { id: 'valmentajat', label: '4. Liikuntalinjan valmentajat' },
  { id: 'sijainti-ja-kartta', label: '5. Sijainti & Kartta' },
  { id: 'yhteydenotto', label: '6. Yhteydenottolomake' },
];

const teachers = [
  { name: 'Päivi Höykinpuro', subjects: 'Ruotsi, saksa' },
  { name: 'Minna Kaartinen', subjects: 'Historia, filosofia, yhteiskuntaoppi' },
  { name: 'Jarmo Kyrönlahti', subjects: 'Uskonto, psykologia' },
  { name: 'Vuokko Laasala', subjects: 'Matematiikka, fysiikka, tietotekniikka' },
  { name: 'Jouko Lehtelä', subjects: 'Maantiede, biologia, terveystieto' },
  { name: 'Raila Lehtelä', subjects: 'Äidinkieli' },
  { name: 'Bea-Sofia Limnell', subjects: 'Kuvataide' },
  { name: 'Anne Luodeslampi', subjects: 'Rehtori, äidinkieli' },
  { name: 'Aleksi Nieminen', subjects: 'Matematiikka, fysiikka, kemia' },
  { name: 'Sari Mäkelä', subjects: 'Apulaisrehtori, matematiikka, kemia' },
  { name: 'Mira Ojala', subjects: 'Erityisopetus' },
  { name: 'Jyrki Paavola', subjects: 'Liikunta, terveystieto' },
  { name: 'Emma Penninkangas', subjects: 'Liikunta (virkavapaalla)' },
  { name: 'Urmas Peräsalo', subjects: 'Musiikki' },
  { name: 'Saila Piispanen', subjects: 'Liikunta' },
  { name: 'Janika Pyhältö', subjects: 'Liikunta' },
  { name: 'Emmi Seppälä', subjects: 'Englanti, venäjä, japani' },
  { name: 'Mikko Vainio', subjects: 'Matematiikka, fysiikka, kemia (virkavapaalla)' },
  { name: 'Janne Visto', subjects: 'Englanti, ranska, espanja, ruotsi' },
  { name: 'Anne Yli-Sissala', subjects: 'Opinto-ohjaus, historia, yhteiskuntaoppi, filosofia' },
];

const coaches = [
  { name: 'Jaakko Kultalahti', sport: 'Pesäpallo', club: 'Alajärven Ankkurit' },
  { name: 'Tapio Rajala', sport: 'Yleisurheilu', club: 'Alajärven Ankkurit' },
  { name: 'Janne Turja', sport: 'Lentopallo', club: 'Alajärven Ankkurit' },
  { name: 'Jussi Virtanen', sport: 'Jääkiekko', club: 'JPK' },
];
---

<Layout title={`${page?.title || 'Yhteystiedot'} | Alajärven lukio`}>
  <Header />

  <main class="py-12 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-8">
      
      <!-- Page Hero Header -->
      <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-alajarvi-900 via-alajarvi-800 to-alajarvi-700 text-white shadow-2xl mb-8 relative overflow-hidden">
        <div class="relative z-10 space-y-4 max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 text-xs font-semibold text-sky-200 border border-white/20">
            <Phone class="w-4 h-4 text-emerald-300" />
            <span>Olemme täällä sinua varten</span>
          </div>
          <h1 class="font-display font-extrabold text-4xl sm:text-5xl text-white tracking-tight">
            {page?.title || 'Yhteystiedot ja henkilökunta'}
          </h1>
          <p class="text-lg text-slate-200 leading-relaxed font-normal">
            Löydä Alajärven lukio johdon, opinto-ohjaajan, opettajien, opiskeluhuollon sekä valmentajien ajantasaiset yhteystiedot.
          </p>
        </div>
      </div>

      {page?.body && (
        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-sm border border-slate-200/80 mb-12">
          <PortableText value={page.body} />
        </div>
      )}

      <!-- Sticky Anchor Links Bar -->
      <LongPageNav anchors={anchors} title="Yhteystiedot - Osioselain" />

      <!-- Long Page Sections -->
      <div class="space-y-12">
        
        <!-- Section 1: Rehtorit & Koulusihteeri -->
        <section id="rehtori-ja-toimisto" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
              1
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
              Rehtorit & Koulusihteeri
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Rehtori -->
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-alajarvi-600 text-white flex items-center justify-center font-bold text-lg">
                  AL
                </div>
                <div>
                  <h3 class="font-bold text-lg text-slate-900">Anne Luodeslampi</h3>
                  <span class="text-xs text-alajarvi-600 font-semibold uppercase tracking-wider">Rehtori</span>
                </div>
              </div>
              <div class="space-y-1.5 text-sm text-slate-600 pt-2 border-t border-slate-200/60">
                <p class="flex items-center gap-2">
                  <Phone class="w-4 h-4 text-alajarvi-500 shrink-0" />
                  <a href="tel:0406739091" class="hover:text-alajarvi-600 font-medium">040 673 9091</a>
                </p>
                <p class="flex items-center gap-2">
                  <Mail class="w-4 h-4 text-alajarvi-500 shrink-0" />
                  <a href="mailto:anne.luodeslampi@alajarvi.fi" class="hover:text-alajarvi-600 text-xs">anne.luodeslampi@alajarvi.fi</a>
                </p>
              </div>
            </div>

            <!-- Apulaisrehtori -->
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-alajarvi-700 text-white flex items-center justify-center font-bold text-lg">
                  SM
                </div>
                <div>
                  <h3 class="font-bold text-lg text-slate-900">Sari Mäkelä</h3>
                  <span class="text-xs text-alajarvi-600 font-semibold uppercase tracking-wider">Apulaisrehtori</span>
                </div>
              </div>
              <div class="space-y-1.5 text-sm text-slate-600 pt-2 border-t border-slate-200/60">
                <p class="flex items-center gap-2">
                  <Phone class="w-4 h-4 text-alajarvi-500 shrink-0" />
                  <a href="tel:0405688322" class="hover:text-alajarvi-600 font-medium">040 568 8322</a>
                </p>
                <p class="flex items-center gap-2">
                  <Mail class="w-4 h-4 text-alajarvi-500 shrink-0" />
                  <a href="mailto:sari.makela@alajarvi.fi" class="hover:text-alajarvi-600 text-xs">sari.makela@alajarvi.fi</a>
                </p>
              </div>
            </div>

            <!-- Koulusihteeri -->
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-alajarvi-800 text-white flex items-center justify-center font-bold text-lg">
                  SM
                </div>
                <div>
                  <h3 class="font-bold text-lg text-slate-900">Satu Mäkelä</h3>
                  <span class="text-xs text-alajarvi-600 font-semibold uppercase tracking-wider">Koulusihteeri / Kanslia</span>
                </div>
              </div>
              <div class="space-y-1.5 text-sm text-slate-600 pt-2 border-t border-slate-200/60">
                <p class="flex items-center gap-2">
                  <Phone class="w-4 h-4 text-alajarvi-500 shrink-0" />
                  <a href="tel:0406620717" class="hover:text-alajarvi-600 font-medium">040 662 0717</a>
                </p>
                <p class="flex items-center gap-2">
                  <Mail class="w-4 h-4 text-alajarvi-500 shrink-0" />
                  <a href="mailto:satu.makela@alajarvi.fi" class="hover:text-alajarvi-600 text-xs">satu.makela@alajarvi.fi</a>
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Section 2: OPO & Opiskeluhuolto -->
        <section id="opinto-ohjaus" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
              2
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
              Opinto-ohjaus & Opiskeluhuolto
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- OPO -->
            <div class="p-6 rounded-2xl bg-alajarvi-50/70 border border-alajarvi-100 space-y-3">
              <div class="flex items-center gap-2 text-alajarvi-700 font-bold">
                <GraduationCap class="w-5 h-5 text-alajarvi-500" />
                <span>Opinto-ohjaaja (OPO)</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900">Anne Yli-Sissala</h3>
              <div class="space-y-1 text-sm text-slate-700 pt-2 border-t border-alajarvi-200">
                <p class="flex items-center gap-2">
                  <Phone class="w-4 h-4 text-alajarvi-500 shrink-0" />
                  <a href="tel:0442970314" class="hover:text-alajarvi-600 font-medium">044 297 0314</a>
                </p>
                <p class="flex items-center gap-2">
                  <Mail class="w-4 h-4 text-alajarvi-500 shrink-0" />
                  <a href="mailto:anne.yli-sissala@alajarvi.fi" class="hover:text-alajarvi-600 text-xs">anne.yli-sissala@alajarvi.fi</a>
                </p>
              </div>
            </div>

            <!-- Kuraattori -->
            <div class="p-6 rounded-2xl bg-alajarvi-50/70 border border-alajarvi-100 space-y-3">
              <div class="flex items-center gap-2 text-alajarvi-700 font-bold">
                <HeartHandshake class="w-5 h-5 text-alajarvi-500" />
                <span>Kuraattori</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900">Antti Latvala</h3>
              <div class="space-y-1 text-sm text-slate-700 pt-2 border-t border-alajarvi-200">
                <p class="flex items-center gap-2">
                  <Phone class="w-4 h-4 text-alajarvi-500 shrink-0" />
                  <a href="tel:0405349442" class="hover:text-alajarvi-600 font-medium">040 534 9442</a>
                </p>
                <p class="flex items-center gap-2">
                  <Mail class="w-4 h-4 text-alajarvi-500 shrink-0" />
                  <a href="mailto:antti.latvala@hyvaep.fi" class="hover:text-alajarvi-600 text-xs">antti.latvala@hyvaep.fi</a>
                </p>
              </div>
            </div>

            <!-- Terveydenhoitaja -->
            <div class="p-6 rounded-2xl bg-alajarvi-50/70 border border-alajarvi-100 space-y-3">
              <div class="flex items-center gap-2 text-alajarvi-700 font-bold">
                <ShieldCheck class="w-5 h-5 text-alajarvi-500" />
                <span>Terveydenhoitaja</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900">Noora Myllymäki</h3>
              <div class="space-y-1 text-sm text-slate-700 pt-2 border-t border-alajarvi-200">
                <p class="flex items-center gap-2">
                  <Phone class="w-4 h-4 text-alajarvi-500 shrink-0" />
                  <a href="tel:0444659532" class="hover:text-alajarvi-600 font-medium">044 465 9532</a>
                </p>
                <p class="flex items-center gap-2">
                  <Mail class="w-4 h-4 text-alajarvi-500 shrink-0" />
                  <a href="mailto:noora.myllymaki@hyvaep.fi" class="hover:text-alajarvi-600 text-xs">noora.myllymaki@hyvaep.fi</a>
                </p>
              </div>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 flex items-center justify-between text-sm">
            <span class="font-bold text-slate-800">Lukion opettajainhuone:</span>
            <a href="tel:0406851154" class="font-semibold text-alajarvi-600 hover:underline">040 685 1154</a>
          </div>
        </section>

        <!-- Section 3: Opettajakunta -->
        <section id="opettajat" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
              3
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
              Opettajakunta
            </h2>
          </div>

          <p class="text-sm text-slate-600 leading-relaxed">
            Opettajien sähköpostiosoitteet ovat muodossa <code class="bg-slate-100 px-2 py-0.5 rounded text-alajarvi-700 text-xs font-mono">etunimi.sukunimi@alajarvi.fi</code>.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {teachers.map(person => (
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1 hover:border-alajarvi-300 transition-colors">
                <h4 class="font-bold text-slate-900 text-sm">{person.name}</h4>
                <p class="text-xs text-alajarvi-600 font-medium">{person.subjects}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 4: Liikuntalinjan valmentajat -->
        <section id="valmentajat" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
              4
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
              Liikuntalinjan valmentajat
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {coaches.map(coach => (
              <div class="p-4 rounded-2xl bg-amber-50/60 border border-amber-200/80 space-y-2">
                <div class="flex items-center gap-2 text-amber-700">
                  <Trophy class="w-4 h-4" />
                  <span class="text-xs font-bold uppercase tracking-wider">{coach.sport}</span>
                </div>
                <h4 class="font-bold text-slate-900 text-base">{coach.name}</h4>
                <p class="text-xs text-slate-600">{coach.club}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 5: Sijainti & Kartta -->
        <section id="sijainti-ja-kartta" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
              5
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
              Sijainti ja osoite
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            <div class="space-y-4 text-slate-700">
              <div class="flex items-start gap-3">
                <MapPin class="w-5 h-5 text-alajarvi-500 shrink-0 mt-1" />
                <div>
                  <h4 class="font-bold text-slate-900">Käyntiosoite</h4>
                  <p class="text-sm text-slate-600">Alajärven lukio<br />Kaupintie 7, 62900 Alajärvi</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <Phone class="w-5 h-5 text-alajarvi-500 shrink-0 mt-1" />
                <div>
                  <h4 class="font-bold text-slate-900">Kanslian puhelinvaihde</h4>
                  <p class="text-sm text-slate-600">040 6620 717 (Ma–Pe klo 08:00 – 15:00)</p>
                </div>
              </div>
            </div>

            <!-- Stylized Map Container -->
            <div class="h-64 rounded-2xl bg-gradient-to-br from-alajarvi-800 to-slate-900 text-white p-6 flex flex-col justify-between shadow-inner relative overflow-hidden">
              <div>
                <span class="text-xs font-bold text-sky-300 uppercase tracking-widest block mb-1">Karttasijainti</span>
                <h4 class="font-display font-bold text-xl text-white">Alajärven lukio</h4>
                <p class="text-xs text-slate-300">Kaupintie 7, 62900 Alajärvi</p>
              </div>

              <a
                href="https://maps.google.com/?q=Alajärven+lukio+Kaupintie+7+Alajärvi"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/20 hover:bg-white text-white hover:text-alajarvi-900 backdrop-blur-md text-xs font-bold transition-all self-start"
              >
                <span>Avaa Google Mapsissa</span>
                <MapPin class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        </section>

        <!-- Section 6: Yhteydenottolomake -->
        <section id="yhteydenotto" class="scroll-mt-28 p-5 sm:p-8 md:p-10 rounded-3xl bg-white shadow-sm border border-slate-200/80 space-y-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-alajarvi-100 text-alajarvi-600 flex items-center justify-center font-bold font-display text-lg">
              6
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-alajarvi-900">
              Lähetä viesti lukiolle
            </h2>
          </div>

          <form class="space-y-4 max-w-2xl" onsubmit="event.preventDefault(); alert('Kiitos yhteydenotostasi! Viestisi on lähetetty.');">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nimesi *</label>
                <input type="text" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-alajarvi-500 focus:ring-2 focus:ring-alajarvi-200 outline-none text-sm" placeholder="Matti Meikäläinen" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Sähköpostiosoite *</label>
                <input type="email" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-alajarvi-500 focus:ring-2 focus:ring-alajarvi-200 outline-none text-sm" placeholder="matti@esimerkki.fi" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Aihe</label>
              <input type="text" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-alajarvi-500 focus:ring-2 focus:ring-alajarvi-200 outline-none text-sm" placeholder="Kysymys lukio-opinnoista" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Viestisi *</label>
              <textarea rows="4" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-alajarvi-500 focus:ring-2 focus:ring-alajarvi-200 outline-none text-sm" placeholder="Kirjoita viestisi tähän..."></textarea>
            </div>

            <button
              type="submit"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-alajarvi-500 hover:bg-alajarvi-600 text-white font-bold text-sm shadow-md transition-all cursor-pointer"
            >
              <Send class="w-4 h-4" />
              <span>Lähetä viesti</span>
            </button>
          </form>
        </section>

      </div>

    </div>
  </main>

  <Footer />
</Layout>
